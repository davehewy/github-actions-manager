{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "bash /agentx/hooks/permission-hook.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash /agentx/hooks/git-guard-pre-tool-use.sh",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}