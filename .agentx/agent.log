{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016KwJzn6UB4zAzH8AEoUPZ8","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import { createOctokit, getWorkflowJobs } from \"@/lib/github\";\n     5→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n     6→\n     7→export async function GET(\n     8→  _request: Request,\n     9→  { params }: { params: Promise<{ owner: string; repo: string; runId: string }> }\n    10→) {\n    11→  try {\n    12→    const session = await getServerSession(authOptions);\n    13→\n    14→    if (!session?.accessToken) {\n    15→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    16→    }\n    17→\n    18→    const { owner, repo, runId } = await params;\n    19→    const octokit = createOctokit(session.accessToken);\n    20→\n    21→    const jobs = await getWorkflowJobs(octokit, owner, repo, parseInt(runId));\n    22→\n    23→    return NextResponse.json(jobs);\n    24→  } catch (error) {\n    25→    console.error(\"Error fetching jobs:\", error);\n    26→    return toGitHubErrorResponse(error, \"Failed to fetch jobs\");\n    27→  }\n    28→}\n    29→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"9273839f-4207-4687-a74e-cce0dc813a24"}
