{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BY2pmruMUQVezaQyYNyCKt","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import { createOctokit, getUser } from \"@/lib/github\";\n     5→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n     6→\n     7→export async function GET() {\n     8→  try {\n     9→    const session = await getServerSession(authOptions);\n    10→\n    11→    if (!session?.accessToken) {\n    12→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    13→    }\n    14→\n    15→    const octokit = createOctokit(session.accessToken);\n    16→    const user = await getUser(octokit);\n    17→\n    18→    return NextResponse.json(user);\n    19→  } catch (error) {\n    20→    console.error(\"Error fetching user:\", error);\n    21→    return toGitHubErrorResponse(error, \"Failed to fetch user\");\n    22→  }\n    23→}\n    24→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"a4a084a5-1d9f-4294-9dc3-3933fcf8346b"}
