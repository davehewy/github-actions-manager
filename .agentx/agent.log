{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q65aohtb1QuUcJUSMHEaVj","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useCallback, useEffect, useMemo, useRef, useState } from \"react\";\n     4→import { OrgSelector } from \"./org-selector\";\n     5→import { WorkflowRunCard, type RunActionState } from \"./workflow-run-card\";\n     6→import { Button } from \"@/components/ui/button\";\n     7→import { Skeleton } from \"@/components/ui/skeleton\";\n     8→import { Tabs, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\n     9→import { Alert, AlertDescription, AlertTitle } from \"@/components/ui/alert\";\n    10→import {\n    11→  Select,\n    12→  SelectContent,\n    13→  SelectItem,\n    14→  SelectTrigger,\n    15→  SelectValue,\n    16→} from \"@/components/ui/select\";\n    17→import type {\n    18→  WorkflowRun,\n    19→  WorkflowRunJobSummary,\n    20→  WorkflowRunJobSummariesResponse,\n    21→  WorkflowRunsMeta,\n    22→  WorkflowRunsResponse,\n    23→} from \"@/lib/github\";\n    24→import {\n    25→  formatRateLimitMessage,\n    26→  isRateLimitActive,\n    27→  isRateLimitApiError,\n    28→  readApiError,\n    29→  type ApiErrorResponse,\n    30→  type RateLimitInfo,\n    31→} from \"@/lib/api-error\";\n    32→import { isActiveWorkflowStatus } from \"@/lib/workflow-status\";\n    33→import {\n    34→  RefreshCw,\n    35→  Activity,\n    36→  CheckCircle2,\n    37→  XCircle,\n    38→  Clock,\n    39→  Loader2,\n    40→  AlertCircle,\n    41→  LayoutGrid,\n    42→  Rows3,\n    43→  ServerCrash,\n    44→  ShieldAlert,\n    45→} from \"lucide-react\";\n    46→import { cn } from \"@/lib/utils\";\n    47→\n    48→type FilterStatus = \"all\" | \"running\" | \"success\" | \"failure\" | \"queued\";\n    49→type ViewMode = \"cards\" | \"ops\";\n    50→type SortMode = \"priority\" | \"newest\" | \"oldest\" | \"duration\" | \"queue-age\" | \"repo\";\n    51→type GroupMode = \"none\" | \"repo\" | \"workflow\" | \"branch\" | \"status\";\n    52→\n    53→interface WorkflowRunSummaryEntry {\n    54→  fetchedAt: string;\n    55→  sourceUpdatedAt: string;\n    56→  summary: WorkflowRunJobSummary;\n    57→}\n    58→\n    59→interface WorkflowRunsPayload {\n    60→  runs: WorkflowRun[];\n    61→  meta: WorkflowRunsMeta | null;\n    62→}\n    63→\n    64→interface RunGroup {\n    65→  key: string;\n    66→  label: string;\n    67→  runs: WorkflowRun[];\n    68→  score: number;\n    69→  failedCount: number;\n    70→  activeCount: number;\n    71→  queuedCount: number;\n    72→}\n    73→\n    74→export function WorkflowDashboard() {\n    75→  const [selectedOrg, setSelectedOrg] = useState<string | null>(null);\n    76→  const [runs, setRuns] = useState<WorkflowRun[]>([]);\n    77→  const [initialLoading, setInitialLoading] = useState(false);\n    78→  const [isRefreshing, setIsRefreshing] = useState(false);\n    79→  const [error, setError] = useState<string | null>(null);\n    80→  const [staleWarning, setStaleWarning] = useState<string | null>(null);\n    81→  const [filter, setFilter] = useState<FilterStatus>(\"all\");\n    82→  const [viewMode, setViewMode] = useState<ViewMode>(\"cards\");\n    83→  const [sortMode, setSortMode] = useState<SortMode>(\"priority\");\n    84→  const [groupMode, setGroupMode] = useState<GroupMode>(\"none\");\n    85→  const [lastUpdated, setLastUpdated] = useState<Date | null>(null);\n    86→  const [autoRefresh, setAutoRefresh] = useState(true);\n    87→  const [expandedRuns, setExpandedRuns] = useState<Set<number>>(new Set());\n    88→  const [loadMeta, setLoadMeta] = useState<WorkflowRunsMeta | null>(null);\n    89→  const [runActionStates, setRunActionStates] = useState<Record<number, RunActionState>>({});\n    90→  const [runSummaryEntries, setRunSummaryEntries] = useState<\n    91→    Record<number, WorkflowRunSummaryEntry>\n    92→  >({});\n    93→  const [summaryLoading, setSummaryLoading] = useState<Record<number, boolean>>({});\n    94→  const [rateLimitInfo, setRateLimitInfo] = useState<RateLimitInfo | null>(null);\n    95→  const hasLoadedOnce = useRef(false);\n    96→\n    97→  const fetchRuns = useCallback(async (isBackgroundRefresh = false) => {\n    98→    if (!selectedOrg) return;\n    99→\n   100→    if (!isBackgroundRefresh && !hasLoadedOnce.current) {\n   101→      setInitialLoading(true);\n   102→    } else {\n   103→      setIsRefreshing(true);\n   104→    }\n   105→\n   106→    if (!isBackgroundRefresh) {\n   107→      setError(null);\n   108→    }\n   109→\n   110→    try {\n   111→      const res = await fetch(`/api/github/runs/${selectedOrg}`, { cache: \"no-store\" });\n   112→      if (!res.ok) {\n   113→        const apiError = await readApiError(res);\n   114→        const error = new Error(apiError.error) as Error & { apiError?: ApiErrorResponse };\n   115→        error.apiError = apiError;\n   116→        throw error;\n   117→      }\n   118→\n   119→      const payload = (await res.json()) as WorkflowRunsResponse | WorkflowRun[];\n   120→      const normalized = normalizeRunsPayload(payload);\n   121→\n   122→      setRuns(normalized.runs);\n   123→      setLoadMeta(normalized.meta);\n   124→      setLastUpdated(new Date(normalized.meta?.fetchedAt ?? Date.now()));\n   125→      setError(null);\n   126→      setStaleWarning(null);\n   127→      setRateLimitInfo(normalized.meta?.rateLimit ?? null);\n   128→      if (normalized.meta?.rateLimit?.limited) {\n   129→        setAutoRefresh(false);\n   130→      }\n   131→      hasLoadedOnce.current = true;\n   132→    } catch (err) {\n   133→      const message = err instanceof Error ? err.message : \"Unknown error\";\n   134→      const apiError =\n   135→        err instanceof Error && \"apiError\" in err\n   136→          ? ((err as Error & { apiError?: ApiErrorResponse }).apiError ?? null)\n   137→          : null;\n   138→\n   139→      if (isRateLimitApiError(apiError)) {\n   140→        setRateLimitInfo(apiError?.rateLimit ?? null);\n   141→        setAutoRefresh(false);\n   142→      }\n   143→\n   144→      const displayMessage = isRateLimitApiError(apiError)\n   145→        ? formatRateLimitMessage(\n   146→            apiError?.rateLimit,\n   147→            \"GitHub API rate limit reached. Live refresh paused.\"\n   148→          )\n   149→        : message;\n   150→\n   151→      if (isBackgroundRefresh && hasLoadedOnce.current) {\n   152→        setStaleWarning(displayMessage);\n   153→      } else {\n   154→        setError(displayMessage);\n   155→      }\n   156→    } finally {\n   157→      setInitialLoading(false);\n   158→      setIsRefreshing(false);\n   159→    }\n   160→  }, [selectedOrg]);\n   161→\n   162→  const toggleRunExpanded = useCallback((runId: number) => {\n   163→    setExpandedRuns((prev) => {\n   164→      const next = new Set(prev);\n   165→      if (next.has(runId)) {\n   166→        next.delete(runId);\n   167→      } else {\n   168→        next.add(runId);\n   169→      }\n   170→      return next;\n   171→    });\n   172→  }, []);\n   173→\n   174→  useEffect(() => {\n   175→    if (!selectedOrg) return;\n   176→\n   177→    hasLoadedOnce.current = false;\n   178→    setRuns([]);\n   179→    setExpandedRuns(new Set());\n   180→    setLoadMeta(null);\n   181→    setLastUpdated(null);\n   182→    setError(null);\n   183→    setStaleWarning(null);\n   184→    setRunActionStates({});\n   185→    setRunSummaryEntries({});\n   186→    setSummaryLoading({});\n   187→    setRateLimitInfo(null);\n   188→    void fetchRuns(false);\n   189→  }, [selectedOrg, fetchRuns]);\n   190→\n   191→  useEffect(() => {\n   192→    if (!autoRefresh || !selectedOrg || isRateLimitActive(rateLimitInfo)) return;\n   193→\n   194→    const interval = window.setInterval(() => {\n   195→      void fetchRuns(true);\n   196→    }, 30000);\n   197→\n   198→    return () => window.clearInterval(interval);\n   199→  }, [autoRefresh, fetchRuns, rateLimitInfo, selectedOrg]);\n   200→\n   201→  useEffect(() => {\n   202→    if (rateLimitInfo && !isRateLimitActive(rateLimitInfo)) {\n   203→      setRateLimitInfo(null);\n   204→      return;\n   205→    }\n   206→\n   207→    if (!isRateLimitActive(rateLimitInfo)) return;\n   208→\n   209→    const delay =\n   210→      rateLimitInfo?.resetAt\n   211→        ? Math.max(0, new Date(rateLimitInfo.resetAt).getTime() - Date.now())\n   212→        : Math.max(0, (rateLimitInfo?.retryAfterSeconds ?? 0) * 1000);\n   213→\n   214→    if (!delay) return;\n   215→\n   216→    const timeout = window.setTimeout(() => {\n   217→      setRateLimitInfo((current) => (current && isRateLimitActive(current) ? current : null));\n   218→    }, delay + 1000);\n   219→\n   220→    return () => window.clearTimeout(timeout);\n   221→  }, [rateLimitInfo]);\n   222→\n   223→  const filteredRuns = useMemo(() => {\n   224→    return runs.filter((run) => {\n   225→      switch (filter) {\n   226→        case \"running\":\n   227→          return run.status === \"in_progress\";\n   228→        case \"success\":\n   229→          return run.conclusion === \"success\";\n   230→        case \"failure\":\n   231→          return run.conclusion === \"failure\";\n   232→        case \"queued\":\n   233→          return run.status === \"queued\" || run.status === \"waiting\";\n   234→        default:\n   235→          return true;\n   236→      }\n   237→    });\n   238→  }, [filter, runs]);\n   239→\n   240→  const sortedRuns = useMemo(() => {\n   241→    const sorted = [...filteredRuns];\n   242→\n   243→    sorted.sort((left, right) => {\n   244→      const leftSummary = runSummaryEntries[left.id]?.summary;\n   245→      const rightSummary = runSummaryEntries[right.id]?.summary;\n   246→\n   247→      switch (sortMode) {\n   248→        case \"newest\":\n   249→          return getRunCreatedAt(right) - getRunCreatedAt(left);\n   250→        case \"oldest\":\n   251→          return getRunCreatedAt(left) - getRunCreatedAt(right);\n   252→        case \"duration\":\n   253→          return getRunDurationMs(right) - getRunDurationMs(left);\n   254→        case \"queue-age\":\n   255→          return getRunQueueAgeMs(right) - getRunQueueAgeMs(left);\n   256→        case \"repo\":\n   257→          return (\n   258→            left.repository.name.localeCompare(right.repository.name) ||\n   259→            getRunCreatedAt(right) - getRunCreatedAt(left)\n   260→          );\n   261→        case \"priority\":\n   262→        default:\n   263→          return (\n   264→            getRunPriorityScore(right, rightSummary) - getRunPriorityScore(left, leftSummary) ||\n   265→            getRunCreatedAt(right) - getRunCreatedAt(left)\n   266→          );\n   267→      }\n   268→    });\n   269→\n   270→    return sorted;\n   271→  }, [filteredRuns, runSummaryEntries, sortMode]);\n   272→\n   273→  const groupedRuns = useMemo(() => {\n   274→    if (groupMode === \"none\") {\n   275→      return [\n   276→        {\n   277→          key: \"all\",\n   278→          label: \"All runs\",\n   279→          runs: sortedRuns,\n   280→          score: 0,\n   281→          failedCount: 0,\n   282→          activeCount: 0,\n   283→          queuedCount: 0,\n   284→        },\n   285→      ];\n   286→    }\n   287→\n   288→    const groups = new Map<string, RunGroup>();\n   289→\n   290→    for (const run of sortedRuns) {\n   291→      const { key, label } = getRunGroup(run, groupMode);\n   292→      const existing = groups.get(key);\n   293→\n   294→      if (existing) {\n   295→        existing.runs.push(run);\n   296→        existing.score += getRunPriorityScore(run, runSummaryEntries[run.id]?.summary);\n   297→        if (run.conclusion === \"failure\") existing.failedCount += 1;\n   298→        if (run.status === \"queued\" || run.status === \"waiting\") existing.queuedCount += 1;\n   299→        if (isActiveWorkflowStatus(run.status)) existing.activeCount += 1;\n   300→      } else {\n   301→        groups.set(key, {\n   302→          key,\n   303→          label,\n   304→          runs: [run],\n   305→          score: getRunPriorityScore(run, runSummaryEntries[run.id]?.summary),\n   306→          failedCount: run.conclusion === \"failure\" ? 1 : 0,\n   307→          activeCount: isActiveWorkflowStatus(run.status) ? 1 : 0,\n   308→          queuedCount: run.status === \"queued\" || run.status === \"waiting\" ? 1 : 0,\n   309→        });\n   310→      }\n   311→    }\n   312→\n   313→    return [...groups.values()].sort(\n   314→      (left, right) => right.score - left.score || left.label.localeCompare(right.label)\n   315→    );\n   316→  }, [groupMode, runSummaryEntries, sortedRuns]);\n   317→\n   318→  const summaryTargets = useMemo(() => {\n   319→    const candidates = new Map<number, WorkflowRun>();\n   320→\n   321→    for (const run of sortedRuns) {\n   322→      if (\n   323→        expandedRuns.has(run.id) ||\n   324→        isActiveWorkflowStatus(run.status) ||\n   325→        run.conclusion === \"failure\"\n   326→      ) {\n   327→        candidates.set(run.id, run);\n   328→      }\n   329→    }\n   330→\n   331→    for (const run of sortedRuns.slice(0, 20)) {\n   332→      candidates.set(run.id, run);\n   333→    }\n   334→\n   335→    return [...candidates.values()];\n   336→  }, [expandedRuns, sortedRuns]);\n   337→\n   338→  useEffect(() => {\n   339→    if (!selectedOrg || summaryTargets.length === 0 || isRateLimitActive(rateLimitInfo)) return;\n   340→\n   341→    const runsToFetch = summaryTargets.filter((run) => {\n   342→      const entry = runSummaryEntries[run.id];\n   343→      return !entry || entry.sourceUpdatedAt !== run.updated_at;\n   344→    });\n   345→\n   346→    if (runsToFetch.length === 0) return;\n   347→\n   348→    let cancelled = false;\n   349→\n   350→    setSummaryLoading((prev) => {\n   351→      const next = { ...prev };\n   352→      for (const run of runsToFetch) {\n   353→        next[run.id] = true;\n   354→      }\n   355→      return next;\n   356→    });\n   357→\n   358→    async function fetchRunSummaries() {\n   359→      try {\n   360→        const res = await fetch(`/api/github/runs/${selectedOrg}/summaries`, {\n   361→          method: \"POST\",\n   362→          headers: {\n   363→            \"Content-Type\": \"application/json\",\n   364→          },\n   365→          body: JSON.stringify({\n   366→            runs: runsToFetch.map((run) => ({\n   367→              repo: run.repository.name,\n   368→              runId: run.id,\n   369→            })),\n   370→          }),\n   371→        });\n   372→\n   373→        if (!res.ok) {\n   374→          const apiError = await readApiError(res);\n   375→\n   376→          if (isRateLimitApiError(apiError)) {\n   377→            setRateLimitInfo(apiError.rateLimit ?? null);\n   378→            setAutoRefresh(false);\n   379→          }\n   380→\n   381→          throw new Error(\n   382→            isRateLimitApiError(apiError)\n   383→              ? formatRateLimitMessage(\n   384→                  apiError.rateLimit,\n   385→                  \"GitHub API rate limit reached while loading run summaries.\"\n   386→                )\n   387→              : apiError.error\n   388→          );\n   389→        }\n   390→\n   391→        const data = (await res.json()) as WorkflowRunJobSummariesResponse;\n   392→\n   393→        if (cancelled) return;\n   394→\n   395→        setRunSummaryEntries((prev) => {\n   396→          const next = { ...prev };\n   397→\n   398→          for (const run of runsToFetch) {\n   399→            const summary = data.summaries[run.id];\n   400→            if (!summary) continue;\n   401→\n   402→            next[run.id] = {\n   403→              summary,\n   404→              fetchedAt: data.meta.fetchedAt,\n   405→              sourceUpdatedAt: run.updated_at,\n   406→            };\n   407→          }\n   408→\n   409→          return next;\n   410→        });\n   411→      } catch (summaryError) {\n   412→        console.error(\"Failed to load run summaries:\", summaryError);\n   413→      } finally {\n   414→        if (cancelled) return;\n   415→\n   416→        setSummaryLoading((prev) => {\n   417→          const next = { ...prev };\n   418→          for (const run of runsToFetch) {\n   419→            delete next[run.id];\n   420→          }\n   421→          return next;\n   422→        });\n   423→      }\n   424→    }\n   425→\n   426→    void fetchRunSummaries();\n   427→\n   428→    return () => {\n   429→      cancelled = true;\n   430→    };\n   431→  }, [rateLimitInfo, runSummaryEntries, selectedOrg, summaryTargets]);\n   432→\n   433→  const setRunActionState = useCallback((runId: number, nextState: RunActionState) => {\n   434→    setRunActionStates((prev) => ({\n   435→      ...prev,\n   436→      [runId]: nextState,\n   437→    }));\n   438→  }, []);\n   439→\n   440→  const clearRunActionState = useCallback((runId: number) => {\n   441→    window.setTimeout(() => {\n   442→      setRunActionStates((prev) => {\n   443→        if (!prev[runId] || prev[runId].status === \"pending\") {\n   444→          return prev;\n   445→        }\n   446→\n   447→        const next = { ...prev };\n   448→        delete next[runId];\n   449→        return next;\n   450→      });\n   451→    }, 4000);\n   452→  }, []);\n   453→\n   454→  const runAction = useCallback(async (\n   455→    run: WorkflowRun,\n   456→    action: \"rerun\" | \"rerun-failed\" | \"cancel\",\n   457→    message: string\n   458→  ) => {\n   459→    if (!selectedOrg) return;\n   460→\n   461→    setRunActionState(run.id, {\n   462→      status: \"pending\",\n   463→      message,\n   464→    });\n   465→\n   466→    try {\n   467→      const res = await fetch(\n   468→        `/api/github/runs/${selectedOrg}/${run.repository.name}/${run.id}/${action}`,\n   469→        { method: \"POST\" }\n   470→      );\n   471→\n   472→      const payload = res.ok ? await res.json().catch(() => null) : await readApiError(res);\n   473→\n   474→      if (!res.ok) {\n   475→        if (isRateLimitApiError(payload)) {\n   476→          setRateLimitInfo(payload.rateLimit ?? null);\n   477→          setAutoRefresh(false);\n   478→        }\n   479→\n   480→        throw new Error(\n   481→          isRateLimitApiError(payload)\n   482→            ? formatRateLimitMessage(\n   483→                payload.rateLimit,\n   484→                \"GitHub API rate limit reached. Action requests paused.\"\n   485→              )\n   486→            : payload?.error || \"Action failed\"\n   487→        );\n   488→      }\n   489→\n   490→      setRunActionState(run.id, {\n   491→        status: \"success\",\n   492→        message:\n   493→          action === \"cancel\"\n   494→            ? \"Cancel request sent to GitHub.\"\n   495→            : action === \"rerun-failed\"\n   496→              ? \"Retry for failed jobs requested.\"\n   497→              : \"Rerun requested.\",\n   498→      });\n   499→\n   500→      clearRunActionState(run.id);\n   501→      window.setTimeout(() => {\n   502→        void fetchRuns(true);\n   503→      }, 1200);\n   504→    } catch (err) {\n   505→      setRunActionState(run.id, {\n   506→        status: \"error\",\n   507→        message: err instanceof Error ? err.message : \"Unknown error\",\n   508→      });\n   509→      clearRunActionState(run.id);\n   510→    }\n   511→  }, [clearRunActionState, fetchRuns, selectedOrg, setRunActionState]);\n   512→\n   513→  const stats = useMemo(() => ({\n   514→    total: runs.length,\n   515→    running: runs.filter((r) => r.status === \"in_progress\").length,\n   516→    queued: runs.filter((r) => r.status === \"queued\" || r.status === \"waiting\").length,\n   517→    success: runs.filter((r) => r.conclusion === \"success\").length,\n   518→    failure: runs.filter((r) => r.conclusion === \"failure\").length,\n   519→  }), [runs]);\n   520→\n   521→  return (\n   522→    <div className=\"space-y-6\">\n   523→      <div className=\"flex flex-col xl:flex-row items-start xl:items-center justify-between gap-4\">\n   524→        <OrgSelector selectedOrg={selectedOrg} onSelect={setSelectedOrg} />\n   525→\n   526→        <div className=\"flex flex-wrap items-center gap-2\">\n   527→          {isRefreshing && (\n   528→            <span className=\"text-xs text-muted-foreground flex items-center gap-1 rounded-md border px-2 py-1\">\n   529→              <Loader2 className=\"h-3 w-3 animate-spin\" />\n   530→              Updating live data\n   531→            </span>\n   532→          )}\n   533→\n   534→          <div className=\"inline-flex items-center rounded-lg border bg-muted/40 p-1\">\n   535→            <Button\n   536→              variant={viewMode === \"cards\" ? \"secondary\" : \"ghost\"}\n   537→              size=\"sm\"\n   538→              onClick={() => setViewMode(\"cards\")}\n   539→              className=\"h-8\"\n   540→            >\n   541→              <LayoutGrid className=\"h-4 w-4\" />\n   542→              Cards\n   543→            </Button>\n   544→            <Button\n   545→              variant={viewMode === \"ops\" ? \"secondary\" : \"ghost\"}\n   546→              size=\"sm\"\n   547→              onClick={() => setViewMode(\"ops\")}\n   548→              className=\"h-8\"\n   549→            >\n   550→              <Rows3 className=\"h-4 w-4\" />\n   551→              Ops view\n   552→            </Button>\n   553→          </div>\n   554→\n   555→          <Button\n   556→            variant=\"outline\"\n   557→            size=\"sm\"\n   558→            onClick={() => setAutoRefresh(!autoRefresh)}\n   559→            className={cn(\n   560→              autoRefresh &&\n   561→                \"bg-green-50 border-green-200 dark:bg-green-950/30 dark:border-green-800\"\n   562→            )}\n   563→          >\n   564→            <Activity className={cn(\"h-4 w-4 mr-1\", autoRefresh && \"text-green-600\")} />\n   565→            {autoRefresh ? \"Live\" : \"Paused\"}\n   566→          </Button>\n   567→\n   568→          <Button\n   569→            variant=\"outline\"\n   570→            size=\"sm\"\n   571→            onClick={() => void fetchRuns(false)}\n   572→            disabled={initialLoading || isRefreshing || !selectedOrg}\n   573→          >\n   574→            <RefreshCw\n   575→              className={cn(\n   576→                \"h-4 w-4 mr-1\",\n   577→                (initialLoading || isRefreshing) && \"animate-spin\"\n   578→              )}\n   579→            />\n   580→            Refresh\n   581→          </Button>\n   582→        </div>\n   583→      </div>\n   584→\n   585→      {selectedOrg && runs.length > 0 && (\n   586→        <div className=\"grid grid-cols-2 md:grid-cols-5 gap-3\">\n   587→          <StatCard\n   588→            label=\"Total\"\n   589→            value={stats.total}\n   590→            icon={Activity}\n   591→            className=\"bg-slate-50 dark:bg-slate-900/50\"\n   592→          />\n   593→          <StatCard\n   594→            label=\"Running\"\n   595→            value={stats.running}\n   596→            icon={Loader2}\n   597→            iconClassName={stats.running > 0 ? \"animate-spin text-blue-500\" : \"\"}\n   598→            className={cn(\n   599→              stats.running > 0 &&\n   600→                \"bg-blue-50 dark:bg-blue-950/30 border-blue-200 dark:border-blue-800\"\n   601→            )}\n   602→          />\n   603→          <StatCard\n   604→            label=\"Queued\"\n   605→            value={stats.queued}\n   606→            icon={Clock}\n   607→            className={cn(\n   608→              stats.queued > 0 &&\n   609→                \"bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800\"\n   610→            )}\n   611→          />\n   612→          <StatCard\n   613→            label=\"Success\"\n   614→            value={stats.success}\n   615→            icon={CheckCircle2}\n   616→            iconClassName=\"text-green-500\"\n   617→            className=\"bg-green-50 dark:bg-green-950/30\"\n   618→          />\n   619→          <StatCard\n   620→            label=\"Failed\"\n   621→            value={stats.failure}\n   622→            icon={XCircle}\n   623→            iconClassName=\"text-red-500\"\n   624→            className={cn(\n   625→              stats.failure > 0 &&\n   626→                \"bg-red-50 dark:bg-red-950/30 border-red-200 dark:border-red-800\"\n   627→            )}\n   628→          />\n   629→        </div>\n   630→      )}\n   631→\n   632→      {selectedOrg && runs.length > 0 && (\n   633→        <div className=\"flex flex-col xl:flex-row xl:items-center justify-between gap-3\">\n   634→          <div className=\"flex flex-col lg:flex-row lg:items-center gap-3\">\n   635→            <Tabs value={filter} onValueChange={(value) => setFilter(value as FilterStatus)}>\n   636→              <TabsList>\n   637→                <TabsTrigger value=\"all\">All ({stats.total})</TabsTrigger>\n   638→                <TabsTrigger value=\"running\">Running ({stats.running})</TabsTrigger>\n   639→                <TabsTrigger value=\"queued\">Queued ({stats.queued})</TabsTrigger>\n   640→                <TabsTrigger value=\"success\">Success ({stats.success})</TabsTrigger>\n   641→                <TabsTrigger value=\"failure\">Failed ({stats.failure})</TabsTrigger>\n   642→              </TabsList>\n   643→            </Tabs>\n   644→\n   645→            <div className=\"flex flex-wrap items-center gap-2\">\n   646→              <Select value={sortMode} onValueChange={(value) => setSortMode(value as SortMode)}>\n   647→                <SelectTrigger className=\"w-[200px]\">\n   648→                  <SelectValue placeholder=\"Sort runs\" />\n   649→                </SelectTrigger>\n   650→                <SelectContent>\n   651→                  <SelectItem value=\"priority\">Priority first</SelectItem>\n   652→                  <SelectItem value=\"newest\">Newest first</SelectItem>\n   653→                  <SelectItem value=\"oldest\">Oldest first</SelectItem>\n   654→                  <SelectItem value=\"duration\">Longest duration</SelectItem>\n   655→                  <SelectItem value=\"queue-age\">Oldest queue age</SelectItem>\n   656→                  <SelectItem value=\"repo\">Repository A-Z</SelectItem>\n   657→                </SelectContent>\n   658→              </Select>\n   659→\n   660→              <Select value={groupMode} onValueChange={(value) => setGroupMode(value as GroupMode)}>\n   661→                <SelectTrigger className=\"w-[180px]\">\n   662→                  <SelectValue placeholder=\"Group runs\" />\n   663→                </SelectTrigger>\n   664→                <SelectContent>\n   665→                  <SelectItem value=\"none\">No grouping</SelectItem>\n   666→                  <SelectItem value=\"repo\">By repository</SelectItem>\n   667→                  <SelectItem value=\"workflow\">By workflow</SelectItem>\n   668→                  <SelectItem value=\"branch\">By branch</SelectItem>\n   669→                  <SelectItem value=\"status\">By status</SelectItem>\n   670→                </SelectContent>\n   671→              </Select>\n   672→            </div>\n   673→          </div>\n   674→\n   675→          {lastUpdated && (\n   676→            <div className=\"text-xs text-muted-foreground rounded-lg border bg-muted/20 px-3 py-2\">\n   677→              Synced {lastUpdated.toLocaleTimeString()}\n   678→              {autoRefresh && \" • polling every 30s\"}\n   679→            </div>\n   680→          )}\n   681→        </div>\n   682→      )}\n   683→\n   684→      {staleWarning && runs.length > 0 && (\n   685→        <Alert className=\"border-amber-200 bg-amber-50/80 text-amber-950 dark:border-amber-900/60 dark:bg-amber-950/20 dark:text-amber-200\">\n   686→          <ServerCrash className=\"h-4 w-4\" />\n   687→          <AlertTitle>Live refresh failed</AlertTitle>\n   688→          <AlertDescription>\n   689→            Showing the last successful snapshot. {staleWarning}\n   690→          </AlertDescription>\n   691→        </Alert>\n   692→      )}\n   693→\n   694→      {rateLimitInfo && (\n   695→        <Alert className=\"border-yellow-200 bg-yellow-50/90 text-yellow-950 dark:border-yellow-900/60 dark:bg-yellow-950/20 dark:text-yellow-200\">\n   696→          <Clock className=\"h-4 w-4\" />\n   697→          <AlertTitle>GitHub rate limit reached</AlertTitle>\n   698→          <AlertDescription>\n   699→            {formatRateLimitMessage(\n   700→              rateLimitInfo,\n   701→              \"Live refresh is paused because GitHub throttled this session.\"\n   702→            )}\n   703→            <p>Manual refresh remains available if you want to test before the reset time.</p>\n   704→          </AlertDescription>\n   705→        </Alert>\n   706→      )}\n   707→\n   708→      {loadMeta && loadMeta.failedRepositories > 0 && (\n   709→        <Alert className=\"border-orange-200 bg-orange-50/80 text-orange-950 dark:border-orange-900/60 dark:bg-orange-950/20 dark:text-orange-200\">\n   710→          <ShieldAlert className=\"h-4 w-4\" />\n   711→          <AlertTitle>Partial repository coverage</AlertTitle>\n   712→          <AlertDescription>\n   713→            Loaded {loadMeta.loadedRepositories} of {loadMeta.totalRepositories} repositories.\n   714→            {loadMeta.failedRepositoryNames.length > 0 && (\n   715→              <p>\n   716→                Failed to read: {loadMeta.failedRepositoryNames.slice(0, 5).join(\", \")}\n   717→                {loadMeta.failedRepositoryNames.length > 5 &&\n   718→                  ` +${loadMeta.failedRepositoryNames.length - 5} more`}\n   719→              </p>\n   720→            )}\n   721→          </AlertDescription>\n   722→        </Alert>\n   723→      )}\n   724→\n   725→      {error && (\n   726→        <Alert variant=\"destructive\">\n   727→          <AlertCircle className=\"h-4 w-4\" />\n   728→          <AlertTitle>Workflow data unavailable</AlertTitle>\n   729→          <AlertDescription>{error}</AlertDescription>\n   730→        </Alert>\n   731→      )}\n   732→\n   733→      {initialLoading && runs.length === 0 && (\n   734→        <div className=\"space-y-3\">\n   735→          {[...Array(5)].map((_, index) => (\n   736→            <Skeleton key={index} className=\"h-28 w-full\" />\n   737→          ))}\n   738→        </div>\n   739→      )}\n   740→\n   741→      {selectedOrg && !initialLoading && runs.length === 0 && !error && (\n   742→        <div className=\"text-center py-12 text-muted-foreground\">\n   743→          <Activity className=\"h-12 w-12 mx-auto mb-4 opacity-50\" />\n   744→          <p className=\"text-lg\">No workflow runs found</p>\n   745→          <p className=\"text-sm\">\n   746→            This organization doesn&apos;t have any recent workflow runs.\n   747→          </p>\n   748→        </div>\n   749→      )}\n   750→\n   751→      {sortedRuns.length > 0 && (\n   752→        viewMode === \"ops\" ? (\n   753→          <div className=\"overflow-x-auto pb-1\">\n   754→            <div className=\"min-w-[1080px] space-y-2\">\n   755→              <div className=\"grid grid-cols-[auto_minmax(0,2.1fr)_minmax(220px,1.4fr)_auto_auto_auto] gap-3 rounded-lg border border-border/60 bg-background/95 px-4 py-2 text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground shadow-sm\">\n   756→                <span>Status</span>\n   757→                <span>Run</span>\n   758→                <span>Signals</span>\n   759→                <span className=\"text-right\">Actor</span>\n   760→                <span className=\"text-right\">Attempt</span>\n   761→                <span className=\"text-right\">Actions</span>\n   762→              </div>\n   763→              {groupedRuns.map((group) => (\n   764→                <div key={group.key} className=\"space-y-2\">\n   765→                  {groupMode !== \"none\" && (\n   766→                    <GroupHeader\n   767→                      label={group.label}\n   768→                      count={group.runs.length}\n   769→                      failedCount={group.failedCount}\n   770→                      activeCount={group.activeCount}\n   771→                      queuedCount={group.queuedCount}\n   772→                    />\n   773→                  )}\n   774→                  {group.runs.map((run) => (\n   775→                    <WorkflowRunCard\n   776→                      key={run.id}\n   777→                      run={run}\n   778→                      org={selectedOrg!}\n   779→                      viewMode={viewMode}\n   780→                      isExpanded={expandedRuns.has(run.id)}\n   781→                      onToggleExpand={() => toggleRunExpanded(run.id)}\n   782→                      onRerun={() => runAction(run, \"rerun\", \"Requesting rerun...\")}\n   783→                      onRerunFailed={() =>\n   784→                        runAction(run, \"rerun-failed\", \"Requesting retry for failed jobs...\")\n   785→                      }\n   786→                      onCancel={() => runAction(run, \"cancel\", \"Sending cancel request...\")}\n   787→                      actionState={runActionStates[run.id]}\n   788→                      jobSummary={runSummaryEntries[run.id]?.summary}\n   789→                      jobSummaryLoading={summaryLoading[run.id] ?? false}\n   790→                      lastUpdated={lastUpdated}\n   791→                    />\n   792→                  ))}\n   793→                </div>\n   794→              ))}\n   795→            </div>\n   796→          </div>\n   797→        ) : (\n   798→          <div className=\"space-y-3\">\n   799→            {groupedRuns.map((group) => (\n   800→              <div key={group.key} className=\"space-y-3\">\n   801→                {groupMode !== \"none\" && (\n   802→                  <GroupHeader\n   803→                    label={group.label}\n   804→                    count={group.runs.length}\n   805→                    failedCount={group.failedCount}\n   806→                    activeCount={group.activeCount}\n   807→                    queuedCount={group.queuedCount}\n   808→                  />\n   809→                )}\n   810→                {group.runs.map((run) => (\n   811→                  <WorkflowRunCard\n   812→                    key={run.id}\n   813→                    run={run}\n   814→                    org={selectedOrg!}\n   815→                    viewMode={viewMode}\n   816→                    isExpanded={expandedRuns.has(run.id)}\n   817→                    onToggleExpand={() => toggleRunExpanded(run.id)}\n   818→                    onRerun={() => runAction(run, \"rerun\", \"Requesting rerun...\")}\n   819→                    onRerunFailed={() =>\n   820→                      runAction(run, \"rerun-failed\", \"Requesting retry for failed jobs...\")\n   821→                    }\n   822→                    onCancel={() => runAction(run, \"cancel\", \"Sending cancel request...\")}\n   823→                    actionState={runActionStates[run.id]}\n   824→                    jobSummary={runSummaryEntries[run.id]?.summary}\n   825→                    jobSummaryLoading={summaryLoading[run.id] ?? false}\n   826→                    lastUpdated={lastUpdated}\n   827→                  />\n   828→                ))}\n   829→              </div>\n   830→            ))}\n   831→          </div>\n   832→        )\n   833→      )}\n   834→    </div>\n   835→  );\n   836→}\n   837→\n   838→function normalizeRunsPayload(payload: WorkflowRunsResponse | WorkflowRun[]): WorkflowRunsPayload {\n   839→  if (Array.isArray(payload)) {\n   840→    return {\n   841→      runs: payload,\n   842→      meta: null,\n   843→    };\n   844→  }\n   845→\n   846→  return {\n   847→    runs: payload.runs,\n   848→    meta: payload.meta,\n   849→  };\n   850→}\n   851→\n   852→function getRunCreatedAt(run: WorkflowRun) {\n   853→  return new Date(run.created_at).getTime();\n   854→}\n   855→\n   856→function getRunDurationMs(run: WorkflowRun) {\n   857→  const start = run.run_started_at ?? run.created_at;\n   858→  const end = isActiveWorkflowStatus(run.status) ? Date.now() : new Date(run.updated_at).getTime();\n   859→  return Math.max(0, end - new Date(start).getTime());\n   860→}\n   861→\n   862→function getRunQueueAgeMs(run: WorkflowRun) {\n   863→  if (run.status !== \"queued\" && run.status !== \"waiting\") {\n   864→    return 0;\n   865→  }\n   866→\n   867→  return Math.max(0, Date.now() - new Date(run.created_at).getTime());\n   868→}\n   869→\n   870→function getRunPriorityScore(run: WorkflowRun, summary?: WorkflowRunJobSummary) {\n   871→  let score = 0;\n   872→\n   873→  if (run.conclusion === \"failure\") score += 1000;\n   874→  if (summary?.failed) score += summary.failed * 50;\n   875→  if (run.status === \"in_progress\") score += 650;\n   876→  if (run.status === \"queued\" || run.status === \"waiting\") {\n   877→    score += 500;\n   878→    score += Math.floor(getRunQueueAgeMs(run) / 60000);\n   879→  }\n   880→  if (summary?.running) score += summary.running * 20;\n   881→  if (summary?.waiting || summary?.pending || summary?.queued) {\n   882→    score += (summary.waiting + summary.pending + summary.queued) * 5;\n   883→  }\n   884→\n   885→  return score;\n   886→}\n   887→\n   888→function getRunGroup(run: WorkflowRun, groupMode: GroupMode) {\n   889→  switch (groupMode) {\n   890→    case \"repo\":\n   891→      return {\n   892→        key: `repo:${run.repository.name}`,\n   893→        label: run.repository.name,\n   894→      };\n   895→    case \"workflow\":\n   896→      return {\n   897→        key: `workflow:${run.name ?? run.display_title}`,\n   898→        label: run.name ?? run.display_title,\n   899→      };\n   900→    case \"branch\":\n   901→      return {\n   902→        key: `branch:${run.head_branch ?? \"no-branch\"}`,\n   903→        label: run.head_branch ?? \"No branch\",\n   904→      };\n   905→    case \"status\":\n   906→      return {\n   907→        key: `status:${run.status ?? run.conclusion ?? \"unknown\"}`,\n   908→        label: formatRunStatusGroup(run),\n   909→      };\n   910→    case \"none\":\n   911→    default:\n   912→      return {\n   913→        key: \"all\",\n   914→        label: \"All runs\",\n   915→      };\n   916→  }\n   917→}\n   918→\n   919→function formatRunStatusGroup(run: WorkflowRun) {\n   920→  if (run.conclusion === \"failure\") return \"Failed\";\n   921→  if (run.status === \"in_progress\") return \"Running\";\n   922→  if (run.status === \"queued\" || run.status === \"waiting\") return \"Queued\";\n   923→  if (run.conclusion === \"success\") return \"Successful\";\n   924→  return run.status ?? run.conclusion ?? \"Unknown\";\n   925→}\n   926→\n   927→function GroupHeader({\n   928→  label,\n   929→  count,\n   930→  failedCount,\n   931→  activeCount,\n   932→  queuedCount,\n   933→}: {\n   934→  label: string;\n   935→  count: number;\n   936→  failedCount: number;\n   937→  activeCount: number;\n   938→  queuedCount: number;\n   939→}) {\n   940→  const tone =\n   941→    failedCount > 0 ? \"danger\" : activeCount > 0 ? \"info\" : queuedCount > 0 ? \"warning\" : \"default\";\n   942→\n   943→  return (\n   944→    <div\n   945→      className={cn(\n   946→        \"flex items-center justify-between rounded-lg border px-4 py-2\",\n   947→        tone === \"danger\" && \"border-red-200 bg-red-50/70 dark:border-red-900/60 dark:bg-red-950/20\",\n   948→        tone === \"info\" && \"border-blue-200 bg-blue-50/70 dark:border-blue-900/60 dark:bg-blue-950/20\",\n   949→        tone === \"warning\" && \"border-amber-200 bg-amber-50/70 dark:border-amber-900/60 dark:bg-amber-950/20\",\n   950→        tone === \"default\" && \"bg-muted/25\"\n   951→      )}\n   952→    >\n   953→      <div className=\"flex items-center gap-3\">\n   954→        <span className=\"text-sm font-semibold\">{label}</span>\n   955→        <span className=\"text-xs text-muted-foreground\">{count} runs</span>\n   956→      </div>\n   957→      <div className=\"flex items-center gap-2 text-xs\">\n   958→        {failedCount > 0 && (\n   959→          <span className=\"rounded-full border border-red-200 bg-red-100 px-2 py-1 font-medium text-red-700 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300\">\n   960→            {failedCount} failed\n   961→          </span>\n   962→        )}\n   963→        {activeCount > 0 && (\n   964→          <span className=\"rounded-full border border-blue-200 bg-blue-100 px-2 py-1 font-medium text-blue-700 dark:border-blue-900 dark:bg-blue-950/40 dark:text-blue-300\">\n   965→            {activeCount} active\n   966→          </span>\n   967→        )}\n   968→        {queuedCount > 0 && (\n   969→          <span className=\"rounded-full border border-amber-200 bg-amber-100 px-2 py-1 font-medium text-amber-700 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300\">\n   970→            {queuedCount} queued\n   971→          </span>\n   972→        )}\n   973→      </div>\n   974→    </div>\n   975→  );\n   976→}\n   977→\n   978→interface StatCardProps {\n   979→  label: string;\n   980→  value: number;\n   981→  icon: React.ComponentType<{ className?: string }>;\n   982→  iconClassName?: string;\n   983→  className?: string;\n   984→}\n   985→\n   986→function StatCard({ label, value, icon: Icon, iconClassName, className }: StatCardProps) {\n   987→  return (\n   988→    <div\n   989→      className={cn(\n   990→        \"rounded-lg border p-3 flex items-center gap-3 transition-colors\",\n   991→        className\n   992→      )}\n   993→    >\n   994→      <Icon className={cn(\"h-5 w-5 text-muted-foreground\", iconClassName)} />\n   995→      <div>\n   996→        <p className=\"text-2xl font-bold\">{value}</p>\n   997→        <p className=\"text-xs text-muted-foreground\">{label}</p>\n   998→      </div>\n   999→    </div>\n  1000→  );\n  1001→}\n  1002→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"c294d54a-50bf-4eb5-921e-7b1b4ede53fd"}
