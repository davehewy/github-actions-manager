{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LRAtd16Tw2qtj7ftbRguLS","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import type { ApiErrorResponse, RateLimitInfo } from \"@/lib/api-error\";\n     3→\n     4→type HeaderBag = Record<string, string | undefined> & {\n     5→  get?: (name: string) => string | null;\n     6→};\n     7→\n     8→function readHeader(headers: HeaderBag | undefined, name: string) {\n     9→  if (!headers) return null;\n    10→\n    11→  if (typeof headers.get === \"function\") {\n    12→    return headers.get(name);\n    13→  }\n    14→\n    15→  return headers[name] ?? headers[name.toLowerCase()] ?? null;\n    16→}\n    17→\n    18→function toNumber(value: string | null) {\n    19→  if (!value) return null;\n    20→  const parsed = Number(value);\n    21→  return Number.isFinite(parsed) ? parsed : null;\n    22→}\n    23→\n    24→function extractRateLimitInfo(error: unknown): RateLimitInfo | undefined {\n    25→  const response = (error as { response?: { headers?: HeaderBag } })?.response;\n    26→  const headers = response?.headers;\n    27→\n    28→  const remaining = toNumber(readHeader(headers, \"x-ratelimit-remaining\"));\n    29→  const resetEpoch = toNumber(readHeader(headers, \"x-ratelimit-reset\"));\n    30→  const retryAfterSeconds = toNumber(readHeader(headers, \"retry-after\"));\n    31→  const resource = readHeader(headers, \"x-ratelimit-resource\");\n    32→  const status =\n    33→    (error as { status?: number })?.status ??\n    34→    (error as { response?: { status?: number } })?.response?.status ??\n    35→    null;\n    36→  const message =\n    37→    (error as { message?: string })?.message ??\n    38→    (error as { response?: { data?: { message?: string } } })?.response?.data?.message ??\n    39→    \"\";\n    40→\n    41→  const limited =\n    42→    status === 429 || remaining === 0 || /rate limit/i.test(message);\n    43→\n    44→  if (!limited) return undefined;\n    45→\n    46→  return {\n    47→    limited: true,\n    48→    resetAt: resetEpoch ? new Date(resetEpoch * 1000).toISOString() : null,\n    49→    retryAfterSeconds,\n    50→    remaining,\n    51→    resource,\n    52→  };\n    53→}\n    54→\n    55→export function toGitHubErrorResponse(error: unknown, fallback: string) {\n    56→  const rateLimit = extractRateLimitInfo(error);\n    57→  const status =\n    58→    rateLimit\n    59→      ? 429\n    60→      : (error as { status?: number })?.status ??\n    61→        (error as { response?: { status?: number } })?.response?.status ??\n    62→        500;\n    63→\n    64→  const payload: ApiErrorResponse = rateLimit\n    65→    ? {\n    66→        error: \"GitHub API rate limit reached.\",\n    67→        code: \"rate_limited\",\n    68→        rateLimit,\n    69→      }\n    70→    : {\n    71→        error: fallback,\n    72→      };\n    73→\n    74→  const headers = new Headers();\n    75→  if (rateLimit?.retryAfterSeconds) {\n    76→    headers.set(\"Retry-After\", String(rateLimit.retryAfterSeconds));\n    77→  }\n    78→\n    79→  return NextResponse.json(payload, {\n    80→    status,\n    81→    headers,\n    82→  });\n    83→}\n    84→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"2df235df-b5df-4a1a-bf87-85560b9edbde"}
