{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GYn5Wja6GEZp9kQazqn32w","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import { createOctokit, rerunFailedJobs } from \"@/lib/github\";\n     5→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n     6→\n     7→export async function POST(\n     8→  _request: Request,\n     9→  { params }: { params: Promise<{ org: string; repo: string; runId: string }> }\n    10→) {\n    11→  try {\n    12→    const session = await getServerSession(authOptions);\n    13→\n    14→    if (!session?.accessToken) {\n    15→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    16→    }\n    17→\n    18→    const { org, repo, runId } = await params;\n    19→    const octokit = createOctokit(session.accessToken);\n    20→\n    21→    await rerunFailedJobs(octokit, org, repo, parseInt(runId));\n    22→\n    23→    return NextResponse.json({ success: true });\n    24→  } catch (error) {\n    25→    console.error(\"Error rerunning failed jobs:\", error);\n    26→    return toGitHubErrorResponse(error, \"Failed to rerun failed jobs\");\n    27→  }\n    28→}\n    29→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"5536e3e8-ae40-4122-95a9-74337d0f6385"}
