{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TutfvaxdscZ2gXKJngdcND","type":"tool_result","content":"     1→export interface RateLimitInfo {\n     2→  limited: boolean;\n     3→  resetAt: string | null;\n     4→  retryAfterSeconds: number | null;\n     5→  remaining: number | null;\n     6→  resource: string | null;\n     7→}\n     8→\n     9→export interface ApiErrorResponse {\n    10→  error: string;\n    11→  code?: string;\n    12→  rateLimit?: RateLimitInfo;\n    13→}\n    14→\n    15→export async function readApiError(response: Response): Promise<ApiErrorResponse> {\n    16→  try {\n    17→    const data = (await response.json()) as ApiErrorResponse;\n    18→    if (typeof data?.error === \"string\") {\n    19→      return data;\n    20→    }\n    21→  } catch {\n    22→    // Fall through to the default error shape.\n    23→  }\n    24→\n    25→  return {\n    26→    error: `Request failed with status ${response.status}`,\n    27→  };\n    28→}\n    29→\n    30→export function isRateLimitApiError(error: ApiErrorResponse | null | undefined) {\n    31→  return error?.code === \"rate_limited\" || error?.rateLimit?.limited === true;\n    32→}\n    33→\n    34→export function formatRateLimitMessage(\n    35→  rateLimit: RateLimitInfo | undefined,\n    36→  fallback = \"GitHub API rate limit reached.\"\n    37→) {\n    38→  if (!rateLimit) return fallback;\n    39→\n    40→  if (rateLimit.resetAt) {\n    41→    const resetTime = new Date(rateLimit.resetAt);\n    42→    return `${fallback} Retry after ${resetTime.toLocaleTimeString()}.`;\n    43→  }\n    44→\n    45→  if (rateLimit.retryAfterSeconds) {\n    46→    return `${fallback} Retry in about ${rateLimit.retryAfterSeconds}s.`;\n    47→  }\n    48→\n    49→  return fallback;\n    50→}\n    51→\n    52→export function isRateLimitActive(rateLimit: RateLimitInfo | null | undefined) {\n    53→  if (!rateLimit?.limited) return false;\n    54→\n    55→  if (rateLimit.resetAt) {\n    56→    return new Date(rateLimit.resetAt).getTime() > Date.now();\n    57→  }\n    58→\n    59→  if (rateLimit.retryAfterSeconds) {\n    60→    return rateLimit.retryAfterSeconds > 0;\n    61→  }\n    62→\n    63→  return true;\n    64→}\n    65→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"7fb2153e-b9c0-46e4-b4fe-0e882fa13ee0"}
