{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C37jtR6kG2ApwCjkkA9J2b","type":"tool_result","content":"     1→import type { WorkflowJob } from \"@/lib/github\";\n     2→\n     3→export interface WorkflowJobStepSummary {\n     4→  total: number;\n     5→  completed: number;\n     6→  running: number;\n     7→  waiting: number;\n     8→  pending: number;\n     9→  queued: number;\n    10→  failed: number;\n    11→  cancelled: number;\n    12→  succeeded: number;\n    13→  skipped: number;\n    14→  hasStarted: boolean;\n    15→}\n    16→\n    17→export interface WorkflowRunJobSummary {\n    18→  total: number;\n    19→  completed: number;\n    20→  running: number;\n    21→  waiting: number;\n    22→  pending: number;\n    23→  queued: number;\n    24→  succeeded: number;\n    25→  failed: number;\n    26→  cancelled: number;\n    27→  skipped: number;\n    28→}\n    29→\n    30→const ACTIVE_WORKFLOW_STATUSES = new Set([\"queued\", \"in_progress\", \"waiting\", \"pending\"]);\n    31→\n    32→export function isActiveWorkflowStatus(status: string | null | undefined) {\n    33→  return ACTIVE_WORKFLOW_STATUSES.has(status ?? \"\");\n    34→}\n    35→\n    36→export function getWorkflowJobStepSummary(job: WorkflowJob): WorkflowJobStepSummary {\n    37→  const steps = job.steps ?? [];\n    38→\n    39→  return {\n    40→    total: steps.length,\n    41→    completed: steps.filter((step) => step.status === \"completed\").length,\n    42→    running: steps.filter((step) => step.status === \"in_progress\").length,\n    43→    waiting: steps.filter((step) => step.status === \"waiting\").length,\n    44→    pending: steps.filter((step) => step.status === \"pending\").length,\n    45→    queued: steps.filter((step) => step.status === \"queued\").length,\n    46→    failed: steps.filter(\n    47→      (step) => step.conclusion === \"failure\" || step.conclusion === \"timed_out\"\n    48→    ).length,\n    49→    cancelled: steps.filter((step) => step.conclusion === \"cancelled\").length,\n    50→    succeeded: steps.filter((step) => step.conclusion === \"success\").length,\n    51→    skipped: steps.filter((step) => step.conclusion === \"skipped\").length,\n    52→    hasStarted: steps.some(\n    53→      (step) =>\n    54→        step.status === \"completed\" ||\n    55→        step.status === \"in_progress\" ||\n    56→        !!step.started_at ||\n    57→        step.conclusion !== null\n    58→    ),\n    59→  };\n    60→}\n    61→\n    62→export function getDisplayedWorkflowJobState(job: WorkflowJob) {\n    63→  const summary = getWorkflowJobStepSummary(job);\n    64→\n    65→  if (summary.total === 0 || job.status === \"completed\") {\n    66→    return {\n    67→      status: job.status,\n    68→      conclusion: job.conclusion,\n    69→      summary,\n    70→    };\n    71→  }\n    72→\n    73→  if (summary.completed === summary.total) {\n    74→    const conclusion =\n    75→      summary.failed > 0\n    76→        ? \"failure\"\n    77→        : summary.cancelled > 0\n    78→          ? \"cancelled\"\n    79→          : summary.succeeded > 0\n    80→            ? \"success\"\n    81→            : summary.skipped === summary.total\n    82→              ? \"skipped\"\n    83→              : job.conclusion;\n    84→\n    85→    return {\n    86→      status: \"completed\",\n    87→      conclusion,\n    88→      summary,\n    89→    };\n    90→  }\n    91→\n    92→  if (summary.running > 0 || summary.waiting > 0 || summary.hasStarted) {\n    93→    return {\n    94→      status: summary.waiting > 0 && summary.running === 0 ? \"waiting\" : \"in_progress\",\n    95→      conclusion: null,\n    96→      summary,\n    97→    };\n    98→  }\n    99→\n   100→  if (summary.pending > 0) {\n   101→    return {\n   102→      status: \"pending\",\n   103→      conclusion: null,\n   104→      summary,\n   105→    };\n   106→  }\n   107→\n   108→  return {\n   109→    status: job.status,\n   110→    conclusion: job.conclusion,\n   111→    summary,\n   112→  };\n   113→}\n   114→\n   115→export function summarizeWorkflowJobs(jobs: WorkflowJob[]): WorkflowRunJobSummary {\n   116→  return jobs.reduce<WorkflowRunJobSummary>(\n   117→    (summary, job) => {\n   118→      const displayed = getDisplayedWorkflowJobState(job);\n   119→\n   120→      summary.total += 1;\n   121→\n   122→      switch (displayed.status) {\n   123→        case \"completed\":\n   124→          summary.completed += 1;\n   125→          switch (displayed.conclusion) {\n   126→            case \"success\":\n   127→              summary.succeeded += 1;\n   128→              break;\n   129→            case \"failure\":\n   130→            case \"timed_out\":\n   131→              summary.failed += 1;\n   132→              break;\n   133→            case \"cancelled\":\n   134→              summary.cancelled += 1;\n   135→              break;\n   136→            case \"skipped\":\n   137→              summary.skipped += 1;\n   138→              break;\n   139→            default:\n   140→              break;\n   141→          }\n   142→          break;\n   143→        case \"in_progress\":\n   144→          summary.running += 1;\n   145→          break;\n   146→        case \"waiting\":\n   147→          summary.waiting += 1;\n   148→          break;\n   149→        case \"pending\":\n   150→          summary.pending += 1;\n   151→          break;\n   152→        default:\n   153→          summary.queued += 1;\n   154→      }\n   155→\n   156→      return summary;\n   157→    },\n   158→    {\n   159→      total: 0,\n   160→      completed: 0,\n   161→      running: 0,\n   162→      waiting: 0,\n   163→      pending: 0,\n   164→      queued: 0,\n   165→      succeeded: 0,\n   166→      failed: 0,\n   167→      cancelled: 0,\n   168→      skipped: 0,\n   169→    }\n   170→  );\n   171→}\n   172→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"39477680-fa18-4aee-be1b-fc4a4e16f7a2"}
