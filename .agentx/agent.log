→\n   852→function getRunCreatedAt(run: WorkflowRun) {\n   853→  return new Date(run.created_at).getTime();\n   854→}\n   855→\n   856→function getRunDurationMs(run: WorkflowRun) {\n   857→  const start = run.run_started_at ?? run.created_at;\n   858→  const end = isActiveWorkflowStatus(run.status) ? Date.now() : new Date(run.updated_at).getTime();\n   859→  return Math.max(0, end - new Date(start).getTime());\n   860→}\n   861→\n   862→function getRunQueueAgeMs(run: WorkflowRun) {\n   863→  if (run.status !== \"queued\" && run.status !== \"waiting\") {\n   864→    return 0;\n   865→  }\n   866→\n   867→  return Math.max(0, Date.now() - new Date(run.created_at).getTime());\n   868→}\n   869→\n   870→function getRunPriorityScore(run: WorkflowRun, summary?: WorkflowRunJobSummary) {\n   871→  let score = 0;\n   872→\n   873→  if (run.conclusion === \"failure\") score += 1000;\n   874→  if (summary?.failed) score += summary.failed * 50;\n   875→  if (run.status === \"in_progress\") score += 650;\n   876→  if (run.status === \"queued\" || run.status === \"waiting\") {\n   877→    score += 500;\n   878→    score += Math.floor(getRunQueueAgeMs(run) / 60000);\n   879→  }\n   880→  if (summary?.running) score += summary.running * 20;\n   881→  if (summary?.waiting || summary?.pending || summary?.queued) {\n   882→    score += (summary.waiting + summary.pending + summary.queued) * 5;\n   883→  }\n   884→\n   885→  return score;\n   886→}\n   887→\n   888→function getRunGroup(run: WorkflowRun, groupMode: GroupMode) {\n   889→  switch (groupMode) {\n   890→    case \"repo\":\n   891→      return {\n   892→        key: `repo:${run.repository.name}`,\n   893→        label: run.repository.name,\n   894→      };\n   895→    case \"workflow\":\n   896→      return {\n   897→        key: `workflow:${run.name ?? run.display_title}`,\n   898→        label: run.name ?? run.display_title,\n   899→      };\n   900→    case \"branch\":\n   901→      return {\n   902→        key: `branch:${