{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017eCErhQpURnTB8dkNw1Whp","type":"tool_result","content":"     1→import { Octokit } from \"@octokit/rest\";\n     2→import type { RateLimitInfo } from \"@/lib/api-error\";\n     3→\n     4→export function createOctokit(accessToken: string) {\n     5→  return new Octokit({\n     6→    auth: accessToken,\n     7→  });\n     8→}\n     9→\n    10→export interface Organization {\n    11→  login: string;\n    12→  id: number;\n    13→  avatar_url: string;\n    14→  description: string | null;\n    15→}\n    16→\n    17→export interface Repository {\n    18→  id: number;\n    19→  name: string;\n    20→  full_name: string;\n    21→  private: boolean;\n    22→  html_url: string;\n    23→  description: string | null;\n    24→  default_branch: string | undefined;\n    25→}\n    26→\n    27→export interface WorkflowRun {\n    28→  id: number;\n    29→  name: string | null | undefined;\n    30→  workflow_id: number;\n    31→  head_branch: string | null;\n    32→  head_sha: string;\n    33→  status: string | null;\n    34→  conclusion: string | null;\n    35→  html_url: string;\n    36→  created_at: string;\n    37→  updated_at: string;\n    38→  run_started_at: string | null | undefined;\n    39→  run_number: number;\n    40→  run_attempt: number | undefined;\n    41→  event: string;\n    42→  display_title: string;\n    43→  repository: {\n    44→    id: number;\n    45→    name: string;\n    46→    full_name: string;\n    47→  };\n    48→  actor: {\n    49→    login: string;\n    50→    avatar_url: string;\n    51→  } | null;\n    52→}\n    53→\n    54→export interface WorkflowRunsMeta {\n    55→  totalRepositories: number;\n    56→  loadedRepositories: number;\n    57→  failedRepositories: number;\n    58→  failedRepositoryNames: string[];\n    59→  fetchedAt: string;\n    60→  rateLimit?: RateLimitInfo | null;\n    61→}\n    62→\n    63→export interface WorkflowRunsResponse {\n    64→  runs: WorkflowRun[];\n    65→  meta: WorkflowRunsMeta;\n    66→}\n    67→\n    68→export interface WorkflowJob {\n    69→  id: number;\n    70→  run_id: number;\n    71→  name: string;\n    72→  status: string;\n    73→  conclusion: string | null;\n    74→  started_at: string | null;\n    75→  completed_at: string | null;\n    76→  steps?: Array<{\n    77→    name: string;\n    78→    status: string;\n    79→    conclusion: string | null;\n    80→    number: number;\n    81→    started_at?: string | null;\n    82→    completed_at?: string | null;\n    83→  }>;\n    84→}\n    85→\n    86→export interface WorkflowRunJobSummary {\n    87→  total: number;\n    88→  completed: number;\n    89→  running: number;\n    90→  waiting: number;\n    91→  pending: number;\n    92→  queued: number;\n    93→  succeeded: number;\n    94→  failed: number;\n    95→  cancelled: number;\n    96→  skipped: number;\n    97→}\n    98→\n    99→export interface WorkflowRunJobSummariesResponse {\n   100→  summaries: Record<number, WorkflowRunJobSummary>;\n   101→  meta: {\n   102→    requestedRuns: number;\n   103→    successfulRuns: number;\n   104→    failedRuns: number;\n   105→    fetchedAt: string;\n   106→  };\n   107→}\n   108→\n   109→export async function getOrganizations(octokit: Octokit): Promise<Organization[]> {\n   110→  const { data } = await octokit.orgs.listForAuthenticatedUser();\n   111→  return data.map((org) => ({\n   112→    login: org.login,\n   113→    id: org.id,\n   114→    avatar_url: org.avatar_url,\n   115→    description: org.description,\n   116→  }));\n   117→}\n   118→\n   119→export async function getUser(octokit: Octokit) {\n   120→  const { data } = await octokit.users.getAuthenticated();\n   121→  return {\n   122→    login: data.login,\n   123→    id: data.id,\n   124→    avatar_url: data.avatar_url,\n   125→    name: data.name,\n   126→  };\n   127→}\n   128→\n   129→export async function getOrgRepos(octokit: Octokit, org: string): Promise<Repository[]> {\n   130→  const repos: Repository[] = [];\n   131→  let page = 1;\n   132→  const perPage = 100;\n   133→\n   134→  while (true) {\n   135→    const { data } = await octokit.repos.listForOrg({\n   136→      org,\n   137→      per_page: perPage,\n   138→      page,\n   139→      sort: \"updated\",\n   140→      direction: \"desc\",\n   141→    });\n   142→\n   143→    repos.push(\n   144→      ...data.map((repo) => ({\n   145→        id: repo.id,\n   146→        name: repo.name,\n   147→        full_name: repo.full_name,\n   148→        private: repo.private,\n   149→        html_url: repo.html_url,\n   150→        description: repo.description,\n   151→        default_branch: repo.default_branch,\n   152→      }))\n   153→    );\n   154→\n   155→    if (data.length < perPage) break;\n   156→    page++;\n   157→    if (page > 5) break; // Limit to 500 repos max\n   158→  }\n   159→\n   160→  return repos;\n   161→}\n   162→\n   163→export async function getUserRepos(octokit: Octokit): Promise<Repository[]> {\n   164→  const repos: Repository[] = [];\n   165→  let page = 1;\n   166→  const perPage = 100;\n   167→\n   168→  while (true) {\n   169→    const { data } = await octokit.repos.listForAuthenticatedUser({\n   170→      per_page: perPage,\n   171→      page,\n   172→      sort: \"updated\",\n   173→      direction: \"desc\",\n   174→      affiliation: \"owner\",\n   175→    });\n   176→\n   177→    repos.push(\n   178→      ...data.map((repo) => ({\n   179→        id: repo.id,\n   180→        name: repo.name,\n   181→        full_name: repo.full_name,\n   182→        private: repo.private,\n   183→        html_url: repo.html_url,\n   184→        description: repo.description,\n   185→        default_branch: repo.default_branch,\n   186→      }))\n   187→    );\n   188→\n   189→    if (data.length < perPage) break;\n   190→    page++;\n   191→    if (page > 5) break;\n   192→  }\n   193→\n   194→  return repos;\n   195→}\n   196→\n   197→export async function getWorkflowRuns(\n   198→  octokit: Octokit,\n   199→  owner: string,\n   200→  repo: string,\n   201→  options: { per_page?: number; status?: string } = {}\n   202→): Promise<WorkflowRun[]> {\n   203→  const { data } = await octokit.actions.listWorkflowRunsForRepo({\n   204→    owner,\n   205→    repo,\n   206→    per_page: options.per_page || 30,\n   207→    ...(options.status && { status: options.status as \"queued\" | \"in_progress\" | \"completed\" }),\n   208→  });\n   209→\n   210→  return data.workflow_runs.map((run) => ({\n   211→    id: run.id,\n   212→    name: run.name,\n   213→    workflow_id: run.workflow_id,\n   214→    head_branch: run.head_branch,\n   215→    head_sha: run.head_sha,\n   216→    status: run.status,\n   217→    conclusion: run.conclusion,\n   218→    html_url: run.html_url,\n   219→    created_at: run.created_at,\n   220→    updated_at: run.updated_at,\n   221→    run_started_at: run.run_started_at,\n   222→    run_number: run.run_number,\n   223→    run_attempt: run.run_attempt,\n   224→    event: run.event,\n   225→    display_title: run.display_title,\n   226→    repository: {\n   227→      id: run.repository.id,\n   228→      name: run.repository.name,\n   229→      full_name: run.repository.full_name,\n   230→    },\n   231→    actor: run.actor\n   232→      ? {\n   233→          login: run.actor.login,\n   234→          avatar_url: run.actor.avatar_url,\n   235→        }\n   236→      : null,\n   237→  }));\n   238→}\n   239→\n   240→export async function getOrgWorkflowRuns(\n   241→  octokit: Octokit,\n   242→  org: string,\n   243→  repos: Repository[]\n   244→): Promise<WorkflowRunsResponse> {\n   245→  const allRuns: WorkflowRun[] = [];\n   246→  const failedRepositoryNames: string[] = [];\n   247→  let rateLimit: RateLimitInfo | null = null;\n   248→\n   249→  // Fetch workflow runs for all repos in parallel (batched)\n   250→  const batchSize = 10;\n   251→  for (let i = 0; i < repos.length; i += batchSize) {\n   252→    const batch = repos.slice(i, i + batchSize);\n   253→    const results = await Promise.allSettled(\n   254→      batch.map((repo) =>\n   255→        getWorkflowRuns(octokit, org, repo.name, { per_page: 10 })\n   256→      )\n   257→    );\n   258→\n   259→    for (const [index, result] of results.entries()) {\n   260→      if (result.status === \"fulfilled\") {\n   261→        allRuns.push(...result.value);\n   262→      } else {\n   263→        failedRepositoryNames.push(batch[index].name);\n   264→        rateLimit = rateLimit ?? extractRateLimitInfo(result.reason);\n   265→      }\n   266→    }\n   267→  }\n   268→\n   269→  // Sort by created_at descending\n   270→  allRuns.sort(\n   271→    (a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()\n   272→  );\n   273→\n   274→  return {\n   275→    runs: allRuns,\n   276→    meta: {\n   277→      totalRepositories: repos.length,\n   278→      loadedRepositories: repos.length - failedRepositoryNames.length,\n   279→      failedRepositories: failedRepositoryNames.length,\n   280→      failedRepositoryNames,\n   281→      fetchedAt: new Date().toISOString(),\n   282→      rateLimit,\n   283→    },\n   284→  };\n   285→}\n   286→\n   287→export async function getWorkflowJobs(\n   288→  octokit: Octokit,\n   289→  owner: string,\n   290→  repo: string,\n   291→  runId: number\n   292→): Promise<WorkflowJob[]> {\n   293→  const { data } = await octokit.actions.listJobsForWorkflowRun({\n   294→    owner,\n   295→    repo,\n   296→    run_id: runId,\n   297→  });\n   298→\n   299→  return data.jobs.map((job) => ({\n   300→    id: job.id,\n   301→    run_id: job.run_id,\n   302→    name: job.name,\n   303→    status: job.status,\n   304→    conclusion: job.conclusion,\n   305→    started_at: job.started_at,\n   306→    completed_at: job.completed_at,\n   307→    steps: job.steps?.map((step) => ({\n   308→      name: step.name,\n   309→      status: step.status,\n   310→      conclusion: step.conclusion,\n   311→      number: step.number,\n   312→      started_at: step.started_at,\n   313→      completed_at: step.completed_at,\n   314→    })),\n   315→  }));\n   316→}\n   317→\n   318→export async function getJobLogs(\n   319→  octokit: Octokit,\n   320→  owner: string,\n   321→  repo: string,\n   322→  jobId: number\n   323→): Promise<string> {\n   324→  try {\n   325→    const { data } = await octokit.actions.downloadJobLogsForWorkflowRun({\n   326→      owner,\n   327→      repo,\n   328→      job_id: jobId,\n   329→    });\n   330→    return data as unknown as string;\n   331→  } catch (error) {\n   332→    if (\n   333→      (error as { status?: number })?.status === 404 ||\n   334→      (error as { response?: { status?: number } })?.response?.status === 404\n   335→    ) {\n   336→      return \"Logs not available\";\n   337→    }\n   338→\n   339→    throw error;\n   340→  }\n   341→}\n   342→\n   343→function extractRateLimitInfo(error: unknown): RateLimitInfo | null {\n   344→  const responseHeaders = (error as { response?: { headers?: Record<string, string> } })?.response?.headers;\n   345→  const status =\n   346→    (error as { status?: number })?.status ??\n   347→    (error as { response?: { status?: number } })?.response?.status ??\n   348→    null;\n   349→  const message =\n   350→    (error as { message?: string })?.message ??\n   351→    (error as { response?: { data?: { message?: string } } })?.response?.data?.message ??\n   352→    \"\";\n   353→  const remainingHeader =\n   354→    responseHeaders?.[\"x-ratelimit-remaining\"] ?? responseHeaders?.[\"X-RateLimit-Remaining\"];\n   355→  const remaining = remainingHeader ? Number(remainingHeader) : null;\n   356→\n   357→  if (status !== 429 && remaining !== 0 && !/rate limit/i.test(message)) {\n   358→    return null;\n   359→  }\n   360→\n   361→  const resetHeader =\n   362→    responseHeaders?.[\"x-ratelimit-reset\"] ?? responseHeaders?.[\"X-RateLimit-Reset\"];\n   363→  const retryAfterHeader =\n   364→    responseHeaders?.[\"retry-after\"] ?? responseHeaders?.[\"Retry-After\"];\n   365→  const resetEpoch = resetHeader ? Number(resetHeader) : null;\n   366→  const retryAfterSeconds = retryAfterHeader ? Number(retryAfterHeader) : null;\n   367→\n   368→  return {\n   369→    limited: true,\n   370→    resetAt: resetEpoch ? new Date(resetEpoch * 1000).toISOString() : null,\n   371→    retryAfterSeconds: Number.isFinite(retryAfterSeconds) ? retryAfterSeconds : null,\n   372→    remaining: Number.isFinite(remaining) ? remaining : null,\n   373→    resource:\n   374→      responseHeaders?.[\"x-ratelimit-resource\"] ??\n   375→      responseHeaders?.[\"X-RateLimit-Resource\"] ??\n   376→      null,\n   377→  };\n   378→}\n   379→\n   380→export async function rerunWorkflow(\n   381→  octokit: Octokit,\n   382→  owner: string,\n   383→  repo: string,\n   384→  runId: number\n   385→): Promise<void> {\n   386→  await octokit.actions.reRunWorkflow({\n   387→    owner,\n   388→    repo,\n   389→    run_id: runId,\n   390→  });\n   391→}\n   392→\n   393→export async function rerunFailedJobs(\n   394→  octokit: Octokit,\n   395→  owner: string,\n   396→  repo: string,\n   397→  runId: number\n   398→): Promise<void> {\n   399→  await octokit.actions.reRunWorkflowFailedJobs({\n   400→    owner,\n   401→    repo,\n   402→    run_id: runId,\n   403→  });\n   404→}\n   405→\n   406→export async function cancelWorkflow(\n   407→  octokit: Octokit,\n   408→  owner: string,\n   409→  repo: string,\n   410→  runId: number\n   411→): Promise<void> {\n   412→  await octokit.actions.cancelWorkflowRun({\n   413→    owner,\n   414→    repo,\n   415→    run_id: runId,\n   416→  });\n   417→}\n   418→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"ae424def-83f8-48c3-934d-8b5c9822028b"}
