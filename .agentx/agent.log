{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LYNBXatJS1oQZvBbgqstaZ","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import { createOctokit, getOrganizations, getUser } from \"@/lib/github\";\n     5→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n     6→\n     7→export async function GET() {\n     8→  try {\n     9→    const session = await getServerSession(authOptions);\n    10→\n    11→    if (!session?.accessToken) {\n    12→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    13→    }\n    14→\n    15→    const octokit = createOctokit(session.accessToken);\n    16→\n    17→    // Get both orgs and user (for personal repos option)\n    18→    const [orgs, user] = await Promise.all([\n    19→      getOrganizations(octokit),\n    20→      getUser(octokit),\n    21→    ]);\n    22→\n    23→    // Add user as first option (for personal repos)\n    24→    const allOptions = [\n    25→      {\n    26→        login: user.login,\n    27→        id: user.id,\n    28→        avatar_url: user.avatar_url,\n    29→        description: \"Personal repositories\",\n    30→        isUser: true,\n    31→      },\n    32→      ...orgs.map((org) => ({ ...org, isUser: false })),\n    33→    ];\n    34→\n    35→    return NextResponse.json(allOptions);\n    36→  } catch (error) {\n    37→    console.error(\"Error fetching organizations:\", error);\n    38→    return toGitHubErrorResponse(error, \"Failed to fetch organizations\");\n    39→  }\n    40→}\n    41→"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"feb944d5-f867-4f76-8987-a49d52a214ad"}
