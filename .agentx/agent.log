2→          </div>\n    53→          <LoginButton />\n    54→        </div>\n    55→      </div>\n    56→    </header>\n    57→  );\n    58→}\n    59→\n    60→function LandingPage() {\n    61→  return (\n    62→    <div className=\"min-h-screen flex flex-col\">\n    63→      {/* Hero Section */}\n    64→      <div className=\"flex-1 flex flex-col items-center justify-center px-4 py-16 bg-gradient-to-b from-background to-muted/30\">\n    65→        <div className=\"max-w-3xl mx-auto text-center space-y-8\">\n    66→          {/* Logo */}\n    67→          <div className=\"flex items-center justify-center gap-3 mb-8\">\n    68→            <div className=\"relative\">\n    69→              <div className=\"absolute inset-0 bg-primary/20 blur-xl rounded-full\" />\n    70→              <Activity className=\"relative h-16 w-16 text-primary\" />\n    71→            </div>\n    72→          </div>\n    73→\n    74→          {/* Title */}\n    75→          <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight\">\n    76→            GitHub Actions\n    77→            <span className=\"block text-primary\">Manager</span>\n    78→          </h1>\n    79→\n    80→          {/* Subtitle */}\n    81→          <p className=\"text-xl text-muted-foreground max-w-xl mx-auto\">\n    82→            Monitor, manage, and optimize your GitHub Actions workflows across all your organizations from a single dashboard.\n    83→          </p>\n    84→\n    85→          {/* CTA */}\n    86→          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-4 pt-4\">\n    87→            <LoginButton />\n    88→            <Button variant=\"outline\" size=\"lg\" asChild>\n    89→              <a\n    90→                href=\"https://github.com\"\n    91→                target=\"_blank\"\n    92→                rel=\"noopener noreferrer\"\n    93→                className=\"flex items-center gap-2\"\n    94→              >\n    95→                <Github className=\"h-5 w-5\" />\n    96→                Learn More\n    97→              </a>\n    98→            </Button>\n    99→          </div>\n   100→        </div>\n   101→      </div>\n   102→\n   103→      <Separator />\n   104→\n   105→      {/* Features Section */}\n   106→      <div className=\"py-16 px-4 bg-muted/20\">\n   107→        <div className=\"max-w-5xl mx-auto\">\n   108→          <h2 className=\"text-2xl font-bold text-center mb-12\">\n   109→            Everything you need to manage your workflows\n   110→          </h2>\n   111→\n   112→          <div className=\"grid md:grid-cols-3 gap-8\">\n   113→            <FeatureCard\n   114→              icon={Eye}\n   115→              title=\"Real-time Monitoring\"\n   116→              description=\"Watch your workflows as they run with live status updates and automatic refresh.\"\n   117→            />\n   118→            <FeatureCard\n   119→              icon={RefreshCw}\n   120→              title=\"Quick Actions\"\n   121→              description=\"Re-run workflows, retry failed jobs, or cancel running builds with a single click.\"\n   122→            />\n   123→            <FeatureCard\n   124→              icon={GitBranch}\n   125→              title=\"Multi-Repo Overview\"\n   126→              description=\"See all workflow runs across your entire organization in one unified view.\"\n   127→            />\n   128→            <FeatureCard\n   129→              icon={Zap}\n   130→              title=\"Instant Logs\"\n   131→              description=\"Access build logs instantly without leaving the dashboard.\"\n   132→            />\n   133→            <FeatureCard\n   134→              icon={Shield}\n   135→              title=\"Secure by Design\"\n   136→              description=\"Uses GitHub OAuth with minimal required permissions to keep your data safe.\"\n   137→            />\n   138→            <FeatureCard\n   139→              icon={Activity}\n   140→              title=\"Status at a Glance\"\n   141→              description=\"Clear visual indicators show you which builds need attention.\"\n   142→            />\n   143→          </div>\n   144→        </div>\n   145→      </div>\n   146→\n   147→      {/* Footer */}\n   148→      <footer className=\"py-8 px-4 border-t\">\n   149→        <div className=\"max-w-5xl mx-auto text-center text-sm text-muted-foreground\">\n   150→          <p>\n   151→            Built with Next.js, Tailwind CSS, and the GitHub API.\n   152→          </p>\n   153→        </div>\n   154→      </footer>\n   155→    </div>\n   156→  );\n   157→}\n   158→\n   159→function FeatureCard({\n   160→  icon: Icon,\n   161→  title,\n   162→  description,\n   163→}: {\n   164→  icon: React.ComponentType<{ className?: string }>;\n   165→  title: string;\n   166→  description: string;\n   167→}) {\n   168→  return (\n   169→    <div className=\"p-6 rounded-xl border bg-card hover:shadow-md transition-shadow\">\n   170→      <Icon className=\"h-10 w-10 text-primary mb-4\" />\n   171→      <h3 className=\"font-semibold text-lg mb-2\">{title}</h3>\n   172→      <p className=\"text-muted-foreground text-sm\">{description}</p>\n   173→    </div>\n   174→  );\n   175→}\n   176→"}]},"parent_tool_use_id":null,"session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"cc37106d-0fba-45b8-a981-e922f049d9c8","tool_use_result":{"type":"text","file":{"filePath":"/home/dave/projects/github-actions-manager/.worktrees/feat-readme-build-it/src/app/page.tsx","content":"\"use client\";\n\nimport { useSession } from \"next-auth/react\";\nimport { LoginButton } from \"@/components/auth/login-button\";\nimport { WorkflowDashboard } from \"@/components/dashboard/workflow-dashboard\";\nimport { Button } from \"@/components/ui/button\";\nimport { Separator } from \"@/components/ui/separator\";\nimport {\n  Activity,\n  GitBranch,\n  Github,\n  Loader2,\n  RefreshCw,\n  Eye,\n  Zap,\n  Shield,\n} from \"lucide-react\";\n\nexport default function Home() {\n  const { data: session, status } = useSession();\n\n  if (status === \"loading\") {\n    return (\n      <div className=\"min-h-screen flex items-center justify-center\">\n        <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n      </div>\n    );\n  }\n\n  if (!session) {\n    return <LandingPage />;\n  }\n\n  return (\n    <div className=\"min-h-screen\">\n      <Header />\n      <main className=\"container mx-auto px-4 py-8 max-w-6xl\">\n        <WorkflowDashboard />\n      </main>\n    </div>\n  );\n}\n\nfunction Header() {\n  return (\n    <header className=\"sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n      <div className=\"container mx-auto px-4 max-w-6xl\">\n        <div className=\"flex h-16 items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <Activity className=\"h-6 w-6 text-primary\" />\n            <span className=\"font-bold text-xl\">Actions Manager</span>\n          </div>\n          <LoginButton />\n        </div>\n      </div>\n    </header>\n  );\n}\n\nfunction LandingPage() {\n  return (\n    <div className=\"min-h-screen flex flex-col\">\n      {/* Hero Section */}\n      <div className=\"flex-1 flex flex-col items-center justify-center px-4 py-16 bg-gradient-to-b from-background to-muted/30\">\n        <div className=\"max-w-3xl mx-auto text-center space-y-8\">\n          {/* Logo */}\n          <div className=\"flex items-center justify-center gap-3 mb-8\">\n            <div className=\"relative\">\n              <div className=\"absolute inset-0 bg-primary/20 blur-xl rounded-full\" />\n              <Activity className=\"relative h-16 w-16 text-primary\" />\n            </div>\n          </div>\n\n          {/* Title */}\n          <h1 className=\"text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight\">\n            GitHub Actions\n            <span className=\"block text-primary\">Manager</span>\n          </h1>\n\n          {/* Subtitle */}\n          <p className=\"text-xl text-muted-foreground max-w-xl mx-auto\">\n            Monitor, manage, and optimize your GitHub Actions workflows across all your organizations from a single dashboard.\n          </p>\n\n          {/* CTA */}\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-4 pt-4\">\n            <LoginButton />\n            <Button variant=\"outline\" size=\"lg\" asChild>\n              <a\n                href=\"https://github.com\"\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"flex items-center gap-2\"\n              >\n                <Github className=\"h-5 w-5\" />\n                Learn More\n              </a>\n            </Button>\n          </div>\n        </div>\n      </div>\n\n      <Separator />\n\n      {/* Features Section */}\n      <div className=\"py-16 px-4 bg-muted/20\">\n        <div className=\"max-w-5xl mx-auto\">\n          <h2 className=\"text-2xl font-bold text-center mb-12\">\n            Everything you need to manage your workflows\n          </h2>\n\n          <div className=\"grid md:grid-cols-3 gap-8\">\n            <FeatureCard\n              icon={Eye}\n              title=\"Real-time Monitoring\"\n              description=\"Watch your workflows as they run with live status updates and automatic refresh.\"\n            />\n            <FeatureCard\n              icon={RefreshCw}\n              title=\"Quick Actions\"\n              description=\"Re-run workflows, retry failed jobs, or cancel running builds with a single click.\"\n            />\n            <FeatureCard\n              icon={GitBranch}\n              title=\"Multi-Repo Overview\"\n              description=\"See all workflow runs across your entire organization in one unified view.\"\n            />\n            <FeatureCard\n              icon={Zap}\n              title=\"Instant Logs\"\n              description=\"Access build logs instantly without leaving the dashboard.\"\n            />\n            <FeatureCard\n              icon={Shield}\n              title=\"Secure by Design\"\n              description=\"Uses GitHub OAuth with minimal required permissions to keep your data safe.\"\n            />\n            <FeatureCard\n              icon={Activity}\n              title=\"Status at a Glance\"\n              description=\"Clear visual indicators show you which builds need attention.\"\n            />\n          </div>\n        </div>\n      </div>\n\n      {/* Footer */}\n      <footer className=\"py-8 px-4 border-t\">\n        <div className=\"max-w-5xl mx-auto text-center text-sm text-muted-foreground\">\n          <p>\n            Built with Next.js, Tailwind CSS, and the GitHub API.\n          </p>\n        </div>\n      </footer>\n    </div>\n  );\n}\n\nfunction FeatureCard({\n  icon: Icon,\n  title,\n  description,\n}: {\n  icon: React.ComponentType<{ className?: string }>;\n  title: string;\n  description: string;\n}) {\n  return (\n    <div className=\"p-6 rounded-xl border bg-card hover:shadow-md transition-shadow\">\n      <Icon className=\"h-10 w-10 text-primary mb-4\" />\n      <h3 className=\"font-semibold text-lg mb-2\">{title}</h3>\n      <p className=\"text-muted-foreground text-sm\">{description}</p>\n    </div>\n  );\n}\n","numLines":176,"startLine":1,"totalLines":176}}}
