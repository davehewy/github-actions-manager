{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pqg7rcqKM6CcvDkw4VUrxz","type":"tool_result","content":"     1→import { Octokit } from \"@octokit/rest\";\n     2→import type { RateLimitInfo } from \"@/lib/api-error\";\n     3→\n     4→export function createOctokit(accessToken: string) {\n     5→  return new Octokit({\n     6→    auth: accessToken,\n     7→  });\n     8→}\n     9→\n    10→export interface Organization {\n    11→  login: string;\n    12→  id: number;\n    13→  avatar_url: string;\n    14→  description: string | null;\n    15→}\n    16→\n    17→export interface Repository {\n    18→  id: number;\n    19→  name: string;\n    20→  full_name: string;\n    21→  private: boolean;\n    22→  html_url: string;\n    23→  description: string | null;\n    24→  default_branch: string | undefined;\n    25→}\n    26→\n    27→export interface WorkflowRun {\n    28→  id: number;\n    29→  name: string | null | undefined;\n    30→  workflow_id: number;\n    31→  head_branch: string | null;\n    32→  head_sha: string;\n    33→  status: string | null;\n    34→  conclusion: string | null;\n    35→  html_url: string;\n    36→  created_at: string;\n    37→  updated_at: string;\n    38→  run_started_at: string | null | undefined;\n    39→  run_number: number;\n    40→  run_attempt: number | undefined;\n    41→  event: string;\n    42→  display_title: string;\n    43→  repository: {\n    44→    id: number;\n    45→    name: string;\n    46→    full_name: string;\n    47→  };\n    48→  actor: {\n    49→    login: string;\n    50→    avatar_url: string;\n    51→  } | null;\n    52→}\n    53→\n    54→export interface WorkflowRunsMeta {\n    55→  totalRepositories: number;\n    56→  loadedRepositories: number;\n    57→  failedRepositories: number;\n    58→  failedRepositoryNames: string[];\n    59→  fetchedAt: string;\n    60→  rateLimit?: RateLimitInfo | null;\n    61→}\n    62→\n    63→export interface WorkflowRunsResponse {\n    64→  runs: WorkflowRun[];\n    65→  meta: WorkflowRunsMeta;\n    66→}\n    67→\n    68→export interface WorkflowJob {\n    69→  id: number;\n    70→  run_id: number;\n    71→  name: string;\n    72→  status: string;\n    73→  conclusion: string | null;\n    74→  started_at: string | null;\n    75→  completed_at: string | null;\n    76→  steps?: Array<{\n    77→    name: string;\n    78→    status: string;\n    79→    conclusion: string | null;\n    80→    number: number;\n    81→    started_at?: string | null;\n    82→    completed_at?: string | null;\n    83→  }>;\n    84→}\n    85→\n    86→export interface WorkflowRunJobSummary {\n    87→  total: number;\n    88→  completed: number;\n    89→  running: number;\n    90→  waiting: number;\n    91→  pending: number;\n    92→  queued: number;\n    93→  succeeded: number;\n    94→  failed: number;\n    95→  cancelled: number;\n    96→  skipped: number;\n    97→}\n    98→\n    99→export interface WorkflowRunJobSummariesResponse {\n   100→  summaries: Record<number, WorkflowRunJobSummary>;"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"50d3bd15-3950-4570-8ccf-b92d96ecfe9b"}
