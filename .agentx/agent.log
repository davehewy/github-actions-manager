{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012DP3raQTQvjGybg4dfK8zn","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import { createOctokit, getOrgRepos, getUserRepos, getUser } from \"@/lib/github\";\n     5→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n     6→\n     7→export async function GET(\n     8→  _request: Request,\n     9→  { params }: { params: Promise<{ org: string }> }\n    10→) {\n    11→  try {\n    12→    const session = await getServerSession(authOptions);\n    13→\n    14→    if (!session?.accessToken) {\n    15→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    16→    }\n    17→\n    18→    const { org } = await params;\n    19→    const octokit = createOctokit(session.accessToken);\n    20→\n    21→    // Check if this is user's personal account\n    22→    const user = await getUser(octokit);\n    23→    const isUserAccount = org === user.login;\n    24→\n    25→    const repos = isUserAccount\n    26→      ? await getUserRepos(octokit)\n    27→      : await getOrgRepos(octokit, org);\n    28→\n    29→    return NextResponse.json(repos);\n    30→  } catch (error) {\n    31→    console.error(\"Error fetching repos:\", error);\n    32→    return toGitHubErrorResponse(error, \"Failed to fetch repositories\");\n    33→  }\n    34→}\n    35→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"b67bbb4f-a0b5-4420-adb9-67d496cf43d3"}
