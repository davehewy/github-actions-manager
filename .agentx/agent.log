{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012P54iQE8mEGjuPRjLv2TzP","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { formatDistanceToNow, differenceInSeconds } from \"date-fns\";\n     4→import { Card, CardContent, CardHeader } from \"@/components/ui/card\";\n     5→import { Button } from \"@/components/ui/button\";\n     6→import { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\n     7→import { Badge } from \"@/components/ui/badge\";\n     8→import {\n     9→  Collapsible,\n    10→  CollapsibleContent,\n    11→  CollapsibleTrigger,\n    12→} from \"@/components/ui/collapsible\";\n    13→import {\n    14→  DropdownMenu,\n    15→  DropdownMenuContent,\n    16→  DropdownMenuItem,\n    17→  DropdownMenuTrigger,\n    18→} from \"@/components/ui/dropdown-menu\";\n    19→import {\n    20→  Tooltip,\n    21→  TooltipContent,\n    22→  TooltipProvider,\n    23→  TooltipTrigger,\n    24→} from \"@/components/ui/tooltip\";\n    25→import { StatusBadge } from \"./status-badge\";\n    26→import { WorkflowJobs } from \"./workflow-jobs\";\n    27→import type { WorkflowRun, WorkflowRunJobSummary } from \"@/lib/github\";\n    28→import { isActiveWorkflowStatus } from \"@/lib/workflow-status\";\n    29→import {\n    30→  ChevronDown,\n    31→  ChevronRight,\n    32→  ExternalLink,\n    33→  GitBranch,\n    34→  GitCommit,\n    35→  MoreVertical,\n    36→  Play,\n    37→  RefreshCw,\n    38→  XCircle,\n    39→  User,\n    40→  AlertCircle,\n    41→  Loader2,\n    42→} from \"lucide-react\";\n    43→import { cn } from \"@/lib/utils\";\n    44→\n    45→export interface RunActionState {\n    46→  status: \"pending\" | \"success\" | \"error\";\n    47→  message: string;\n    48→}\n    49→\n    50→interface WorkflowRunCardProps {\n    51→  run: WorkflowRun;\n    52→  org: string;\n    53→  viewMode: \"cards\" | \"ops\";\n    54→  isExpanded: boolean;\n    55→  onToggleExpand: () => void;\n    56→  onRerun: () => Promise<void>;\n    57→  onRerunFailed: () => Promise<void>;\n    58→  onCancel: () => Promise<void>;\n    59→  actionState?: RunActionState;\n    60→  jobSummary?: WorkflowRunJobSummary;\n    61→  jobSummaryLoading: boolean;\n    62→  lastUpdated: Date | null;\n    63→}\n    64→\n    65→export function WorkflowRunCard({\n    66→  run,\n    67→  org,\n    68→  viewMode,\n    69→  isExpanded,\n    70→  onToggleExpand,\n    71→  onRerun,\n    72→  onRerunFailed,\n    73→  onCancel,\n    74→  actionState,\n    75→  jobSummary,\n    76→  jobSummaryLoading,\n    77→  lastUpdated,\n    78→}: WorkflowRunCardProps) {\n    79→  const isRunning = isActiveWorkflowStatus(run.status);\n    80→  const isExecuting = run.status === \"in_progress\" || run.status === \"pending\";\n    81→  const hasFailed = run.conclusion === \"failure\";\n    82→  const isQueued = run.status === \"queued\" || run.status === \"waiting\";\n    83→  const isActionPending = actionState?.status === \"pending\";\n    84→  const summaryMetrics = buildSummaryMetrics(run, jobSummary, jobSummaryLoading, lastUpdated);\n    85→\n    86→  const handleCancel = async () => {\n    87→    if (!window.confirm(`Cancel workflow run \"${run.display_title}\"?`)) {\n    88→      return;\n    89→    }\n    90→\n    91→    await onCancel();\n    92→  };\n    93→\n    94→  if (viewMode === \"ops\") {\n    95→    return (\n    96→      <Collapsible open={isExpanded} onOpenChange={onToggleExpand}>\n    97→        <Card\n    98→          className={cn(\n    99→            \"gap-0 overflow-hidden rounded-lg border-l-4 shadow-sm transition-colors\",\n   100→            hasFailed &&\n   101→              \"border-red-300 border-l-red-500 bg-red-50/35 dark:border-red-900/70 dark:border-l-red-500 dark:bg-red-950/12\",\n   102→            isExecuting &&\n   103→              !hasFailed &&\n   104→              \"border-blue-300 border-l-blue-500 bg-blue-50/30 dark:border-blue-900/70 dark:border-l-blue-500 dark:bg-blue-950/12\",\n   105→            isQueued &&\n   106→              !hasFailed &&\n   107→              !isExecuting &&\n   108→              \"border-amber-300 border-l-amber-500 bg-amber-50/30 dark:border-amber-900/70 dark:border-l-amber-500 dark:bg-amber-950/12\",\n   109→            !hasFailed &&\n   110→              !isExecuting &&\n   111→              !isQueued &&\n   112→              \"border-slate-200 border-l-slate-300 dark:border-slate-800 dark:border-l-slate-700\"\n   113→          )}\n   114→        >\n   115→          <div className=\"px-3 py-3\">\n   116→            <div className=\"grid grid-cols-[auto_minmax(0,2.1fr)_minmax(220px,1.4fr)_auto_auto_auto] gap-3 items-center\">\n   117→              <div className=\"flex items-center gap-2\">\n   118→                <CollapsibleTrigger asChild>\n   119→                  <Button variant=\"ghost\" size=\"sm\" className=\"h-8 w-8 p-0 shrink-0\">\n   120→                    {isExpanded ? (\n   121→                      <ChevronDown className=\"h-4 w-4\" />\n   122→                    ) : (\n   123→                      <ChevronRight className=\"h-4 w-4\" />\n   124→                    )}\n   125→                  </Button>\n   126→                </CollapsibleTrigger>\n   127→                <div className=\"flex flex-col items-start gap-1\">\n   128→                  <StatusBadge status={run.status} conclusion={run.conclusion} />\n   129→                  <span\n   130→                    className={cn(\n   131→                      \"text-[10px] font-semibold uppercase tracking-[0.16em]\",\n   132→                      hasFailed && \"text-red-700 dark:text-red-300\",\n   133→                      isExecuting && !hasFailed && \"text-blue-700 dark:text-blue-300\",\n   134→                      isQueued && !hasFailed && \"text-amber-700 dark:text-amber-300\",\n   135→                      !hasFailed && !isExecuting && !isQueued && \"text-muted-foreground\"\n   136→                    )}\n   137→                  >\n   138→                    {hasFailed\n   139→                      ? \"Needs attention\"\n   140→                      : isExecuting\n   141→                        ? \"Active\"\n   142→                        : isQueued\n   143→                          ? \"Waiting\"\n   144→                          : \"Stable\"}\n   145→                  </span>\n   146→                </div>\n   147→              </div>\n   148→\n   149→              <div className=\"min-w-0\">\n   150→                <div className=\"flex items-center gap-2\">"}]},"parent_tool_use_id":"toolu_01J9eiHC5DSp78dwfDEjh4H3","session_id":"4433484f-60dd-42c7-bc8f-791da8f86c0a","uuid":"91a33e0d-556e-453c-8f6e-03ca5ff94eca"}
