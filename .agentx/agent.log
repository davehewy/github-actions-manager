{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016FbDKnxi5qRnyRKRQ8dSVr","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import {\n     5→  createOctokit,\n     6→  getOrgRepos,\n     7→  getUserRepos,\n     8→  getUser,\n     9→  getOrgWorkflowRuns,\n    10→} from \"@/lib/github\";\n    11→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n    12→\n    13→export async function GET(\n    14→  _request: Request,\n    15→  { params }: { params: Promise<{ org: string }> }\n    16→) {\n    17→  try {\n    18→    const session = await getServerSession(authOptions);\n    19→\n    20→    if (!session?.accessToken) {\n    21→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    22→    }\n    23→\n    24→    const { org } = await params;\n    25→    const octokit = createOctokit(session.accessToken);\n    26→\n    27→    // Check if this is user's personal account\n    28→    const user = await getUser(octokit);\n    29→    const isUserAccount = org === user.login;\n    30→\n    31→    // Get repos first\n    32→    const repos = isUserAccount\n    33→      ? await getUserRepos(octokit)\n    34→      : await getOrgRepos(octokit, org);\n    35→\n    36→    // Get workflow runs for all repos\n    37→    const response = await getOrgWorkflowRuns(octokit, org, repos);\n    38→\n    39→    return NextResponse.json(response);\n    40→  } catch (error) {\n    41→    console.error(\"Error fetching workflow runs:\", error);\n    42→    return toGitHubErrorResponse(error, \"Failed to fetch workflow runs\");\n    43→  }\n    44→}\n    45→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"24d7d3e0-2177-46ed-8d5c-ac1394ef6a48"}
