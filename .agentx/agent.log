{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XHcMRa6CYNYKEdPgk95cL9","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useEffect, useState } from \"react\";\n     4→import {\n     5→  Select,\n     6→  SelectContent,\n     7→  SelectItem,\n     8→  SelectTrigger,\n     9→  SelectValue,\n    10→} from \"@/components/ui/select\";\n    11→import { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\";\n    12→import { Skeleton } from \"@/components/ui/skeleton\";\n    13→import { Building2, User } from \"lucide-react\";\n    14→import { formatRateLimitMessage, isRateLimitApiError, readApiError } from \"@/lib/api-error\";\n    15→\n    16→interface OrgOption {\n    17→  login: string;\n    18→  id: number;\n    19→  avatar_url: string;\n    20→  description: string | null;\n    21→  isUser: boolean;\n    22→}\n    23→\n    24→interface OrgSelectorProps {\n    25→  onSelect: (org: string) => void;\n    26→  selectedOrg: string | null;\n    27→}\n    28→\n    29→export function OrgSelector({ onSelect, selectedOrg }: OrgSelectorProps) {\n    30→  const [orgs, setOrgs] = useState<OrgOption[]>([]);\n    31→  const [loading, setLoading] = useState(true);\n    32→  const [error, setError] = useState<string | null>(null);\n    33→\n    34→  useEffect(() => {\n    35→    async function fetchOrgs() {\n    36→      try {\n    37→        const res = await fetch(\"/api/github/orgs\");\n    38→        if (!res.ok) {\n    39→          const apiError = await readApiError(res);\n    40→          throw new Error(\n    41→            isRateLimitApiError(apiError)\n    42→              ? formatRateLimitMessage(\n    43→                  apiError.rateLimit,\n    44→                  \"GitHub API rate limit reached while loading organizations.\"\n    45→                )\n    46→              : apiError.error\n    47→          );\n    48→        }\n    49→        const data = await res.json();\n    50→        setOrgs(data);\n    51→\n    52→        // Auto-select first org if none selected\n    53→        if (!selectedOrg && data.length > 0) {\n    54→          onSelect(data[0].login);\n    55→        }\n    56→      } catch (err) {\n    57→        setError(err instanceof Error ? err.message : \"Unknown error\");\n    58→      } finally {\n    59→        setLoading(false);\n    60→      }\n    61→    }\n    62→\n    63→    fetchOrgs();\n    64→  }, [onSelect, selectedOrg]);\n    65→\n    66→  if (loading) {\n    67→    return (\n    68→      <div className=\"flex items-center gap-2\">\n    69→        <Skeleton className=\"h-10 w-[250px]\" />\n    70→      </div>\n    71→    );\n    72→  }\n    73→\n    74→  if (error) {\n    75→    return (\n    76→      <div className=\"text-destructive text-sm\">\n    77→        Error loading organizations: {error}\n    78→      </div>\n    79→    );\n    80→  }\n    81→\n    82→  const selectedOrgData = orgs.find((org) => org.login === selectedOrg);\n    83→\n    84→  return (\n    85→    <Select value={selectedOrg || undefined} onValueChange={onSelect}>\n    86→      <SelectTrigger className=\"w-[280px] h-12\">\n    87→        <SelectValue placeholder=\"Select organization\">\n    88→          {selectedOrgData && (\n    89→            <div className=\"flex items-center gap-2\">\n    90→              <Avatar className=\"h-6 w-6\">\n    91→                <AvatarImage src={selectedOrgData.avatar_url} />\n    92→                <AvatarFallback>\n    93→                  {selectedOrgData.isUser ? (\n    94→                    <User className=\"h-4 w-4\" />\n    95→                  ) : (\n    96→                    <Building2 className=\"h-4 w-4\" />\n    97→                  )}\n    98→                </AvatarFallback>\n    99→              </Avatar>\n   100→              <span className=\"font-medium\">{selectedOrgData.login}</span>\n   101→              {selectedOrgData.isUser && (\n   102→                <span className=\"text-xs text-muted-foreground\">(personal)</span>\n   103→              )}\n   104→            </div>\n   105→          )}\n   106→        </SelectValue>\n   107→      </SelectTrigger>\n   108→      <SelectContent>\n   109→        {orgs.map((org) => (\n   110→          <SelectItem key={org.id} value={org.login}>\n   111→            <div className=\"flex items-center gap-2\">\n   112→              <Avatar className=\"h-6 w-6\">\n   113→                <AvatarImage src={org.avatar_url} />\n   114→                <AvatarFallback>\n   115→                  {org.isUser ? (\n   116→                    <User className=\"h-4 w-4\" />\n   117→                  ) : (\n   118→                    <Building2 className=\"h-4 w-4\" />\n   119→                  )}\n   120→                </AvatarFallback>\n   121→              </Avatar>\n   122→              <div className=\"flex flex-col\">\n   123→                <span className=\"font-medium\">{org.login}</span>\n   124→                {org.description && (\n   125→                  <span className=\"text-xs text-muted-foreground line-clamp-1\">\n   126→                    {org.description}\n   127→                  </span>\n   128→                )}\n   129→              </div>\n   130→            </div>\n   131→          </SelectItem>\n   132→        ))}\n   133→      </SelectContent>\n   134→    </Select>\n   135→  );\n   136→}\n   137→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"0d0344a5-ecf8-48a8-8282-043805e023d7"}
