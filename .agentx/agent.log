{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wj9TEoagBWZiDDdNgRrTYf","type":"tool_result","content":"     1→import { NextResponse } from \"next/server\";\n     2→import { getServerSession } from \"next-auth\";\n     3→import { authOptions } from \"@/lib/auth\";\n     4→import {\n     5→  createOctokit,\n     6→  getWorkflowJobs,\n     7→  type WorkflowRunJobSummariesResponse,\n     8→} from \"@/lib/github\";\n     9→import { toGitHubErrorResponse } from \"@/lib/github-route-error\";\n    10→import { summarizeWorkflowJobs } from \"@/lib/workflow-status\";\n    11→\n    12→interface SummaryRequestRun {\n    13→  repo: string;\n    14→  runId: number;\n    15→}\n    16→\n    17→interface SummaryRequestBody {\n    18→  runs?: SummaryRequestRun[];\n    19→}\n    20→\n    21→export async function POST(\n    22→  request: Request,\n    23→  { params }: { params: Promise<{ org: string }> }\n    24→) {\n    25→  try {\n    26→    const session = await getServerSession(authOptions);\n    27→\n    28→    if (!session?.accessToken) {\n    29→      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n    30→    }\n    31→\n    32→    const body = (await request.json()) as SummaryRequestBody;\n    33→    const requestedRuns = body.runs ?? [];\n    34→    const uniqueRuns = requestedRuns.filter(\n    35→      (run, index, allRuns) =>\n    36→        allRuns.findIndex(\n    37→          (candidate) => candidate.repo === run.repo && candidate.runId === run.runId\n    38→        ) === index\n    39→    );\n    40→\n    41→    const { org } = await params;\n    42→    const octokit = createOctokit(session.accessToken);\n    43→\n    44→    const response: WorkflowRunJobSummariesResponse = {\n    45→      summaries: {},\n    46→      meta: {\n    47→        requestedRuns: uniqueRuns.length,\n    48→        successfulRuns: 0,\n    49→        failedRuns: 0,\n    50→        fetchedAt: new Date().toISOString(),\n    51→      },\n    52→    };\n    53→\n    54→    const batchSize = 6;\n    55→\n    56→    for (let index = 0; index < uniqueRuns.length; index += batchSize) {\n    57→      const batch = uniqueRuns.slice(index, index + batchSize);\n    58→      const results = await Promise.allSettled(\n    59→        batch.map(async ({ repo, runId }) => {\n    60→          const jobs = await getWorkflowJobs(octokit, org, repo, runId);\n    61→          return {\n    62→            runId,\n    63→            summary: summarizeWorkflowJobs(jobs),\n    64→          };\n    65→        })\n    66→      );\n    67→\n    68→      for (const result of results) {\n    69→        if (result.status === \"fulfilled\") {\n    70→          response.summaries[result.value.runId] = result.value.summary;\n    71→          response.meta.successfulRuns += 1;\n    72→        } else {\n    73→          response.meta.failedRuns += 1;\n    74→        }\n    75→      }\n    76→    }\n    77→\n    78→    return NextResponse.json(response);\n    79→  } catch (error) {\n    80→    console.error(\"Error fetching workflow run summaries:\", error);\n    81→    return toGitHubErrorResponse(error, \"Failed to fetch workflow run summaries\");\n    82→  }\n    83→}\n    84→"}]},"parent_tool_use_id":"toolu_01CZkSgrsB2gphzcmXCNrW1W","session_id":"bc23d326-89d9-481a-b0c0-3e13574a6bab","uuid":"e911b8f9-31a3-410f-9414-ac6f5e38f886"}
